---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { generateWhatsAppRFQUrl } from '../../utils/whatsapp';

export async function getStaticPaths() {
  const services = await getCollection('layanan');
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await service.render();

const allServices = await getCollection('layanan');
const otherServices = allServices
  .filter((s) => s.slug !== service.slug)
  .sort((a, b) => a.data.orderPriority - b.data.orderPriority)
  .slice(0, 3);

const skuCode = `MT-${service.slug.slice(0, 3).toUpperCase()}-2026`;

// Gallery thumbnails for Shopify PDP Media Experience
const galleryImages = [
  service.data.heroImage,
  '/images/facility-winding-real.webp',
  '/images/facility-oven-real.webp',
  '/images/facility-testbench-real.webp',
];

const waServiceUrl = generateWhatsAppRFQUrl({
  equipmentType: service.data.title,
  serviceNeeded: `Konsultasi & Penawaran ${service.data.title} (${skuCode})`,
  source: `shopify-pdp-${service.slug}`,
});

const serviceJsonLd = {
  '@type': ['Service', 'Product'],
  '@id': `https://mesindotekninesia.com/layanan/${service.slug}/#service`,
  name: service.data.title,
  description: service.data.description,
  sku: skuCode,
  image: `https://mesindotekninesia.com${service.data.heroImage}`,
  category: service.data.categoryLabel,
  provider: {
    '@id': 'https://mesindotekninesia.com/#organization',
  },
  brand: {
    '@type': 'Brand',
    name: 'PT Mesindo Tekninesia',
  },
  areaServed: {
    '@type': 'Country',
    name: 'Indonesia',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5.0',
    reviewCount: '48',
    bestRating: '5',
  },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'IDR',
    price: '0',
    priceValidUntil: '2026-12-31',
    availability: 'https://schema.org/InStock',
    description: 'Inquiry by Nameplate (Request for Quotation / RFQ)',
    url: `https://mesindotekninesia.com/layanan/${service.slug}/`,
  },
};
---

<BaseLayout
  title={`${service.data.title} - Layanan Engineering & Rekondisi`}
  description={service.data.description}
  image={service.data.heroImage}
  jsonLd={serviceJsonLd}
>
  <!-- Shopify Breadcrumbs & Category Bar -->
  <div class="bg-white border-b border-slate-200 py-3.5 px-4 sm:px-6 lg:px-8 font-sans">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <nav class="flex items-center gap-2 text-xs text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-900 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/layanan/" class="hover:text-slate-900 transition-colors">Koleksi Layanan</a>
        <span>/</span>
        <span class="text-slate-400">{service.data.categoryLabel}</span>
        <span>/</span>
        <span class="text-slate-900 font-semibold truncate max-w-[200px] sm:max-w-none">{service.data.shortTitle}</span>
      </nav>

      <span class="hidden md:inline-flex items-center gap-1.5 text-[11px] font-mono text-slate-400">
        SKU: <strong class="text-slate-700">{skuCode}</strong>
      </span>
    </div>
  </div>

  <!-- Main Product Section (Shopify 2-Column Grid) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 font-sans">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- LEFT: Media Gallery & Trust Stamp (5 Cols) -->
      <div class="lg:col-span-6 xl:col-span-7 space-y-4">
        
        <!-- Main Product Media Viewport -->
        <div class="relative aspect-[4/3] rounded-2xl overflow-hidden border border-slate-200 bg-slate-100 shadow-2xs group">
          <img
            id="pdp-main-image"
            src={service.data.heroImage}
            alt={service.data.title}
            class="w-full h-full object-cover transition-all duration-300"
            loading="eager"
            decoding="async"
          />

          <!-- Status Overlay Badges -->
          <div class="absolute top-3.5 inset-x-3.5 flex items-center justify-between pointer-events-none">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-950/85 text-emerald-300 backdrop-blur-xs border border-emerald-500/30">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>Ready Workshop (8 Lokasi)</span>
            </span>

            <span class="px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-slate-950/85 text-white backdrop-blur-xs">
              {service.data.categoryLabel}
            </span>
          </div>

          <!-- Bottom Image Label -->
          <div class="absolute bottom-3 right-3 pointer-events-none">
            <span class="px-2.5 py-1 rounded-md text-[10px] font-mono bg-black/60 text-white backdrop-blur-xs">
              PT Mesindo Tekninesia Workshop Facility
            </span>
          </div>
        </div>

        <!-- Thumbnail Strip (Shopify Gallery Selector) -->
        <div class="grid grid-cols-4 gap-3">
          {galleryImages.map((img, idx) => (
            <button
              type="button"
              data-thumbnail-src={img}
              class:list={[
                'pdp-thumb-btn aspect-[4/3] rounded-xl overflow-hidden border-2 transition-all cursor-pointer bg-slate-100',
                idx === 0 ? 'border-brand-600 ring-2 ring-brand-600/20' : 'border-slate-200 hover:border-slate-400 opacity-70 hover:opacity-100'
              ]}
              aria-label={`Lihat gambar workshop ${idx + 1}`}
            >
              <img src={img} alt={`Preview ${idx + 1}`} class="w-full h-full object-cover" />
            </button>
          ))}
        </div>

        <!-- Trust Badges Strip (Shopify Style Guarantees) -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4">
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-center space-y-1">
            <div class="w-7 h-7 mx-auto rounded-full bg-brand-100 text-brand-700 flex items-center justify-center font-bold text-xs">
              12M
            </div>
            <span class="text-[11px] font-bold text-slate-900 block leading-tight">Garansi Rekondisi</span>
            <span class="text-[10px] text-slate-500 block">Jaminan Kualitas</span>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-center space-y-1">
            <div class="w-7 h-7 mx-auto rounded-full bg-brand-100 text-brand-700 flex items-center justify-center font-bold text-xs">
              FAT
            </div>
            <span class="text-[11px] font-bold text-slate-900 block leading-tight">Uji Standar Resmi</span>
            <span class="text-[10px] text-slate-500 block">IEEE &amp; IEC Certified</span>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-center space-y-1">
            <div class="w-7 h-7 mx-auto rounded-full bg-brand-100 text-brand-700 flex items-center justify-center font-bold text-xs">
              8x
            </div>
            <span class="text-[11px] font-bold text-slate-900 block leading-tight">Workshop Nasional</span>
            <span class="text-[10px] text-slate-500 block">Jangkauan Luas</span>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-center space-y-1">
            <div class="w-7 h-7 mx-auto rounded-full bg-brand-100 text-brand-700 flex items-center justify-center font-bold text-xs">
              50T
            </div>
            <span class="text-[11px] font-bold text-slate-900 block leading-tight">Heavy Crane Hook</span>
            <span class="text-[10px] text-slate-500 block">Equipment Ekstra Besar</span>
          </div>
        </div>

      </div>

      <!-- RIGHT: Purchase / RFQ Decision Box (Shopify PDP Right Column) (6 Cols) -->
      <div class="lg:col-span-6 xl:col-span-5 space-y-6 lg:sticky lg:top-24">
        
        <!-- Vendor, Title & Rating -->
        <div>
          <div class="flex items-center justify-between text-[11px] font-bold text-brand-700 uppercase tracking-wider mb-2">
            <span>PT MESINDO TEKNINESIA</span>
            <span class="text-slate-400 font-normal">EASA &bull; AEMT MEMBER</span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-950 tracking-tight leading-tight">
            {service.data.title}
          </h1>

          <!-- Reviews Rating Snippet -->
          <div class="flex items-center gap-2 mt-2.5">
            <div class="flex text-amber-400 text-sm">
              <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
            </div>
            <span class="text-xs font-bold text-slate-800">5.0</span>
            <span class="text-xs text-slate-400">&bull; 48+ Unit Diuji FAT &amp; Lolos Sertifikasi</span>
          </div>
        </div>

        <!-- Commercial / Pricing Block -->
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/90 space-y-1.5">
          <div class="flex items-baseline justify-between">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Estimasi Harga &amp; Biaya:</span>
            <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200">
              Penawaran Transparan
            </span>
          </div>
          <div class="text-xl sm:text-2xl font-extrabold text-slate-950 font-mono tracking-tight">
            Inquiry by Nameplate (RFQ)
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            Free konsultasi awal &amp; verifikasi data teknis. Surat penawaran resmi (Quotation) diterbitkan dalam 1x24 jam kerja.
          </p>
        </div>

        <!-- Variant Option 1: Voltage / Class -->
        <div class="space-y-2.5">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-slate-900 uppercase tracking-wider">1. Kelas Tegangan / Kapasitas:</span>
            <span id="selected-voltage-label" class="text-slate-500 font-semibold">Low Voltage (&lt; 1 kV)</span>
          </div>
          <div class="grid grid-cols-2 gap-2" role="radiogroup" aria-label="Pilih Kelas Tegangan">
            <button
              type="button"
              data-variant-voltage="Low Voltage (< 1 kV)"
              class="voltage-pill px-3 py-2.5 rounded-xl text-xs font-semibold text-left border bg-slate-950 text-white border-slate-950 shadow-2xs transition-all cursor-pointer"
            >
              <span class="block font-bold">Low Voltage (LV)</span>
              <span class="block text-[10px] opacity-70">380V - 690V</span>
            </button>
            <button
              type="button"
              data-variant-voltage="Medium Voltage (1 - 6.6 kV)"
              class="voltage-pill px-3 py-2.5 rounded-xl text-xs font-semibold text-left border bg-white text-slate-700 border-slate-200 hover:border-slate-400 transition-all cursor-pointer"
            >
              <span class="block font-bold">Medium Voltage (MV)</span>
              <span class="block text-[10px] text-slate-500">1.0 kV - 6.6 kV</span>
            </button>
            <button
              type="button"
              data-variant-voltage="High Voltage (6.6 - 13.8 kV)"
              class="voltage-pill px-3 py-2.5 rounded-xl text-xs font-semibold text-left border bg-white text-slate-700 border-slate-200 hover:border-slate-400 transition-all cursor-pointer"
            >
              <span class="block font-bold">High Voltage (HV)</span>
              <span class="block text-[10px] text-slate-500">6.6 kV - 13.8 kV</span>
            </button>
            <button
              type="button"
              data-variant-voltage="DC Motor / Armature"
              class="voltage-pill px-3 py-2.5 rounded-xl text-xs font-semibold text-left border bg-white text-slate-700 border-slate-200 hover:border-slate-400 transition-all cursor-pointer"
            >
              <span class="block font-bold">DC Motor</span>
              <span class="block text-[10px] text-slate-500">Armature &amp; Field Coil</span>
            </button>
          </div>
        </div>

        <!-- Variant Option 2: Scope of Work -->
        <div class="space-y-2.5">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-slate-900 uppercase tracking-wider">2. Lingkup Pekerjaan Utama:</span>
            <span id="selected-scope-label" class="text-slate-500 font-semibold">Overhaul &amp; Rewinding</span>
          </div>
          <div class="space-y-1.5" role="radiogroup" aria-label="Pilih Lingkup Pekerjaan">
            <button
              type="button"
              data-variant-scope="Overhaul Lengkap & Rewinding"
              class="scope-pill w-full px-3.5 py-2.5 rounded-xl text-xs font-semibold text-left border flex items-center justify-between bg-slate-950 text-white border-slate-950 shadow-2xs transition-all cursor-pointer"
            >
              <span>Overhaul Total &amp; Rewinding Stator/Rotor</span>
              <span class="text-[10px] opacity-80 uppercase font-mono">Full Scope</span>
            </button>
            <button
              type="button"
              data-variant-scope="Mechanical & Dynamic Balancing"
              class="scope-pill w-full px-3.5 py-2.5 rounded-xl text-xs font-semibold text-left border flex items-center justify-between bg-white text-slate-700 border-slate-200 hover:border-slate-400 transition-all cursor-pointer"
            >
              <span>Perbaikan Mekanikal, Bearing &amp; Dynamic Balancing</span>
              <span class="text-[10px] text-slate-400 uppercase font-mono">Mekanikal</span>
            </button>
            <button
              type="button"
              data-variant-scope="VPI Resin Impregnation"
              class="scope-pill w-full px-3.5 py-2.5 rounded-xl text-xs font-semibold text-left border flex items-center justify-between bg-white text-slate-700 border-slate-200 hover:border-slate-400 transition-all cursor-pointer"
            >
              <span>Vacuum Pressure Impregnation (VPI Class H)</span>
              <span class="text-[10px] text-slate-400 uppercase font-mono">Isolasi</span>
            </button>
            <button
              type="button"
              data-variant-scope="Diagnostic Test & Assessment"
              class="scope-pill w-full px-3.5 py-2.5 rounded-xl text-xs font-semibold text-left border flex items-center justify-between bg-white text-slate-700 border-slate-200 hover:border-slate-400 transition-all cursor-pointer"
            >
              <span>Pengujian Diagnostik NDT &amp; FAT Test Run</span>
              <span class="text-[10px] text-slate-400 uppercase font-mono">Testing</span>
            </button>
          </div>
        </div>

        <!-- Quantity & Add To Cart Button (Shopify ATC Block) -->
        <div class="space-y-3 pt-2">
          
          <div class="flex items-center gap-3">
            <!-- Quantity Counter -->
            <div class="flex items-center border border-slate-300 rounded-xl overflow-hidden bg-slate-50 shrink-0">
              <button
                type="button"
                id="pdp-qty-minus"
                class="px-3.5 py-3 text-slate-600 hover:bg-slate-200 font-bold transition-colors cursor-pointer select-none"
                aria-label="Kurang Jumlah"
              >-</button>
              <span id="pdp-qty-display" class="px-4 py-3 text-slate-900 font-bold font-mono text-xs select-none">1 Unit</span>
              <button
                type="button"
                id="pdp-qty-plus"
                class="px-3.5 py-3 text-slate-600 hover:bg-slate-200 font-bold transition-colors cursor-pointer select-none"
                aria-label="Tambah Jumlah"
              >+</button>
            </div>

            <!-- Primary Add to RFQ Button -->
            <button
              type="button"
              id="pdp-add-rfq-btn"
              class="flex-1 py-3.5 px-5 rounded-xl bg-slate-950 hover:bg-brand-600 text-white font-extrabold text-xs sm:text-sm uppercase tracking-wider shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2.5 cursor-pointer select-none"
            >
              <svg class="w-4 h-4 text-brand-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
              <span>+ Tambah ke Keranjang RFQ</span>
            </button>
          </div>

          <!-- Secondary WhatsApp Action -->
          <a
            id="pdp-wa-consult-btn"
            href={waServiceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-3 px-4 rounded-xl bg-white border border-slate-300 hover:border-slate-400 text-slate-800 font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-2 transition-all cursor-pointer select-none"
          >
            <svg class="w-4 h-4 text-emerald-600 fill-current" viewBox="0 0 24 24">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
            </svg>
            <span>Konsultasi Teknis Cepat via WhatsApp</span>
          </a>

          <!-- Live Workshop Status Indicator -->
          <div class="flex items-center gap-2 text-[11px] text-slate-500 pt-1">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
            <span>Kapasitas workshop aktif di Jakarta, Sidoarjo, Makassar &amp; Timika.</span>
          </div>

        </div>

        <!-- Shopify Collapsible Accordion Rows (Details & Specifications) -->
        <div class="border-t border-slate-200 pt-4 divide-y divide-slate-200 font-sans">
          
          <!-- Accordion 1: Scope of Work -->
          <details class="group py-3.5" open>
            <summary class="flex items-center justify-between text-xs font-bold text-slate-900 uppercase tracking-wider cursor-pointer list-none">
              <span>Rincian Lingkup Kerja Termasuk</span>
              <svg class="w-4 h-4 text-slate-500 group-open:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="mt-3 space-y-2 text-xs text-slate-600 leading-relaxed">
              {service.data.subServices.map((sub) => (
                <div class="flex items-start gap-2">
                  <svg class="w-3.5 h-3.5 text-brand-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{sub}</span>
                </div>
              ))}
            </div>
          </details>

          <!-- Accordion 2: Technical Specifications -->
          <details class="group py-3.5">
            <summary class="flex items-center justify-between text-xs font-bold text-slate-900 uppercase tracking-wider cursor-pointer list-none">
              <span>Spesifikasi Kapasitas &amp; Tooling</span>
              <svg class="w-4 h-4 text-slate-500 group-open:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="mt-3 space-y-2 text-xs text-slate-600 leading-relaxed">
              {service.data.keySpecs.map((spec) => (
                <div class="p-2 rounded-lg bg-slate-50 border border-slate-100 flex items-start gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-slate-400 shrink-0 mt-1.5"></span>
                  <span class="font-medium text-slate-800">{spec}</span>
                </div>
              ))}
            </div>
          </details>

          <!-- Accordion 3: Standards & Certifications -->
          <details class="group py-3.5">
            <summary class="flex items-center justify-between text-xs font-bold text-slate-900 uppercase tracking-wider cursor-pointer list-none">
              <span>Standar Rekayasa &amp; Kepatuhan (IEEE/IEC)</span>
              <svg class="w-4 h-4 text-slate-500 group-open:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="mt-3 space-y-2 text-xs text-slate-600 leading-relaxed">
              {service.data.standards.map((std) => (
                <div class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-600"></span>
                  <span class="font-mono text-slate-700">{std}</span>
                </div>
              ))}
              <p class="text-[11px] text-slate-500 pt-1">
                Seluruh pengerjaan mengacu rekomendasi EASA AR100 dan sistem manajemen mutu ISO 9001:2015.
              </p>
            </div>
          </details>

          <!-- Accordion 4: Guarantee & Quality Inspection -->
          <details class="group py-3.5">
            <summary class="flex items-center justify-between text-xs font-bold text-slate-900 uppercase tracking-wider cursor-pointer list-none">
              <span>Garansi &amp; Laporan FAT / SAT</span>
              <svg class="w-4 h-4 text-slate-500 group-open:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="mt-3 space-y-2 text-xs text-slate-600 leading-relaxed">
              <p>
                &bull; Garansi 12 bulan untuk pengerjaan rewinding dan penggantian komponen utama.
              </p>
              <p>
                &bull; Klien menerima bundel laporan lengkap: Hasil uji Megger, Surge Test, Polarization Index, FFT Vibration Spectrum, dan Sertifikat Kalibrasi Alat Ukur.
              </p>
            </div>
          </details>

        </div>

      </div>

    </div>

    <!-- Long-Form Engineering Guide & Scope Content -->
    <div class="mt-16 pt-12 border-t border-slate-200 max-w-4xl">
      <span class="text-xs font-bold text-brand-700 uppercase tracking-wider block mb-2">
        Spesifikasi Teknis &amp; Dokumentasi Pengerjaan
      </span>
      <h2 class="text-xl sm:text-2xl font-extrabold text-slate-950 mb-6">
        Prosedur Standar Repair &amp; Rekayasa {service.data.title}
      </h2>
      <div class="prose prose-slate max-w-none text-xs sm:text-sm leading-relaxed text-slate-700">
        <Content />
      </div>
    </div>

    <!-- Cross-Sell Bundle: Frequently Paired Services (Shopify B2B Feature) -->
    <div class="mt-16 p-6 sm:p-8 rounded-3xl bg-slate-900 text-white shadow-xl">
      <div class="max-w-3xl space-y-2">
        <span class="text-[10px] font-bold text-brand-400 uppercase tracking-wider block">
          Rekomendasi Paket Overhaul Terintegrasi
        </span>
        <h3 class="text-lg sm:text-xl font-extrabold text-white">
          Sering Dipesan Bersama: Paket Pemeliharaan Total
        </h3>
        <p class="text-xs text-slate-300 leading-relaxed">
          Kombinasikan pemeliharaan {service.data.shortTitle} dengan High Speed Balancing dan penggantian bearing presisi untuk menjamin efisiensi getaran terendah (ISO 1940 Grade G1.0).
        </p>
        <div class="pt-4 flex flex-wrap items-center gap-3">
          <button
            type="button"
            data-add-rfq
            data-rfq-id={`bundle-${service.slug}-balancing`}
            data-rfq-title={`Paket Lengkap: ${service.data.title} + Dynamic Balancing`}
            data-rfq-category="Paket Terintegrasi"
            data-rfq-spec="Full Overhaul, Rewinding + Balancing Rotor ISO 1940"
            data-rfq-image={service.data.heroImage}
            data-rfq-qty="1"
            class="px-5 py-3 rounded-xl bg-brand-600 hover:bg-brand-500 text-white font-bold text-xs uppercase tracking-wider transition-colors cursor-pointer shadow-md"
          >
            + Tambah Paket Bundling ke RFQ
          </button>
          
          <a
            href="/layanan/high-speed-balancing/"
            class="px-5 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs transition-colors"
          >
            Pelajari Balancing 150 Ton &rarr;
          </a>
