<!-- Client Interactivity Script for PDP (Variants, Quantity, ATC, WhatsApp) -->
<script is:inline define:vars={{ serviceTitle: service.data.title, serviceSlug: service.slug, serviceCategory: service.data.categoryLabel, serviceHeroImage: service.data.heroImage }}>
  (function () {
    let currentQty = 1;
    let selectedVoltage = 'Low Voltage (< 1 kV)';
    let selectedScope = 'Overhaul Lengkap & Rewinding';

    // Elements
    const mainImage = document.getElementById('pdp-main-image');
    const thumbBtns = document.querySelectorAll('.pdp-thumb-btn');
    const voltagePills = document.querySelectorAll('.voltage-pill');
    const scopePills = document.querySelectorAll('.scope-pill');
    const voltageLabel = document.getElementById('selected-voltage-label');
    const scopeLabel = document.getElementById('selected-scope-label');
    const qtyDisplay = document.getElementById('pdp-qty-display');
    const qtyMinusBtn = document.getElementById('pdp-qty-minus');
    const qtyPlusBtn = document.getElementById('pdp-qty-plus');
    const addRfqBtn = document.getElementById('pdp-add-rfq-btn');
    const waConsultBtn = document.getElementById('pdp-wa-consult-btn');

    // Thumbnail switching
    thumbBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-thumbnail-src');
        if (mainImage && src) {
          mainImage.src = src;
        }
        thumbBtns.forEach(b => {
          b.classList.remove('border-brand-600', 'ring-2', 'ring-brand-600/20');
          b.classList.add('border-slate-200', 'opacity-70');
        });
        btn.classList.remove('border-slate-200', 'opacity-70');
        btn.classList.add('border-brand-600', 'ring-2', 'ring-brand-600/20');
      });
    });

    // Voltage variant selection
    voltagePills.forEach(pill => {
      pill.addEventListener('click', () => {
        selectedVoltage = pill.getAttribute('data-variant-voltage') || '';
        if (voltageLabel) voltageLabel.textContent = selectedVoltage;

        voltagePills.forEach(p => {
          p.classList.remove('bg-slate-950', 'text-white', 'border-slate-950', 'shadow-2xs');
          p.classList.add('bg-white', 'text-slate-700', 'border-slate-200');
        });
        pill.classList.remove('bg-white', 'text-slate-700', 'border-slate-200');
        pill.classList.add('bg-slate-950', 'text-white', 'border-slate-950', 'shadow-2xs');

        updateWhatsAppUrl();
      });
    });

    // Scope variant selection
    scopePills.forEach(pill => {
      pill.addEventListener('click', () => {
        selectedScope = pill.getAttribute('data-variant-scope') || '';
        if (scopeLabel) scopeLabel.textContent = selectedScope;

        scopePills.forEach(p => {
          p.classList.remove('bg-slate-950', 'text-white', 'border-slate-950', 'shadow-2xs');
          p.classList.add('bg-white', 'text-slate-700', 'border-slate-200');
        });
        pill.classList.remove('bg-white', 'text-slate-700', 'border-slate-200');
        pill.classList.add('bg-slate-950', 'text-white', 'border-slate-950', 'shadow-2xs');

        updateWhatsAppUrl();
      });
    });

    // Quantity controls
    if (qtyMinusBtn) {
      qtyMinusBtn.addEventListener('click', () => {
        if (currentQty > 1) {
          currentQty--;
          if (qtyDisplay) qtyDisplay.textContent = `${currentQty} Unit`;
          updateWhatsAppUrl();
        }
      });
    }

    if (qtyPlusBtn) {
      qtyPlusBtn.addEventListener('click', () => {
        currentQty++;
        if (qtyDisplay) qtyDisplay.textContent = `${currentQty} Unit`;
        updateWhatsAppUrl();
      });
    }

    // Dynamic WhatsApp URL generator reflecting active variants
    function updateWhatsAppUrl() {
      if (!waConsultBtn) return;
      const message = `*KONSULTASI TEKNIS / RFQ - PT MESINDO TEKNINESIA*\n` +
        `----------------------------------------\n` +
        `Halo Tim Engineering PT Mesindo Tekninesia, saya ingin mengajukan penawaran untuk:\n` +
        `• *Layanan:* ${serviceTitle}\n` +
        `• *Jumlah:* ${currentQty} Unit\n` +
        `• *Kelas Tegangan:* ${selectedVoltage}\n` +
        `• *Lingkup Kerja:* ${selectedScope}\n` +
        `----------------------------------------\n` +
        `Mohon informasi estimasi biaya awal dan ketersediaan workshop terdekat.\n` +
        `[Ref: shopify-pdp-${serviceSlug}]`;

      const newUrl = `https://wa.me/6285183002070?text=${encodeURIComponent(message)}`;
      waConsultBtn.href = newUrl;
    }

    // Add To RFQ Cart Action
    if (addRfqBtn) {
      addRfqBtn.addEventListener('click', () => {
        if (window.addEquipmentToRfq) {
          window.addEquipmentToRfq({
            id: `${serviceSlug}-${Date.now().toString().slice(-4)}`,
            title: serviceTitle,
            category: serviceCategory,
            variant: `${selectedVoltage} | ${selectedScope}`,
            spec: `${selectedVoltage} • ${selectedScope}`,
            image: serviceHeroImage,
            quantity: currentQty
          });
        }
      });
    }

    // Initialize initial WhatsApp URL
    updateWhatsAppUrl();
  })();
</script>
