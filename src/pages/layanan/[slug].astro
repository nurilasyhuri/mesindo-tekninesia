      </div>
    </div>

    <!-- Related Services (Shopify Product Grid) -->
    <div class="mt-16 pt-12 border-t border-slate-200">
      <div class="flex items-center justify-between mb-8">
        <div>
          <span class="text-xs font-bold text-brand-700 uppercase tracking-wider block mb-1">
            Koleksi Layanan Lainnya
          </span>
          <h3 class="text-xl font-extrabold text-slate-950">
            Layanan Terkait di Workshop Kami
          </h3>
        </div>
        <a
          href="/layanan/"
          class="text-xs font-bold text-brand-700 hover:text-brand-800 uppercase tracking-wider inline-flex items-center gap-1"
        >
          <span>Semua Koleksi (8)</span>
