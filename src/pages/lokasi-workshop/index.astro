---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COMPANY_INFO } from '../../data/companyInfo';
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';
---

<BaseLayout
  title="Jaringan 10 Workshop Industri Nasional - MESINDO TEKNISIA"
  description="Daftar 10 workshop resmi MESINDO TEKNISIA di Jakarta, Sidoarjo, Bekasi, Pekanbaru, Makassar, hingga Timika melayani industri berat & maritim."
>
  <!-- Page Header -->
  <div class="bg-slate-50 border-b border-slate-200/80 py-12 sm:py-16 px-4 sm:px-6 lg:px-8 font-sans">
    <div class="max-w-7xl mx-auto">
      <span class="text-xs font-bold text-brand-700 uppercase tracking-wider block mb-2">
        Jaringan Workshop &amp; Rekayasa Lapangan
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
        Workshop Operasional di Seluruh Indonesia
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 mt-3 max-w-3xl leading-relaxed">
        Dengan jaringan workshop yang tersebar di sentra industri dan pertambangan utama Indonesia — dari Jawa, Sumatera, Sulawesi, hingga Papua — kami memberikan respon penanganan darurat yang cepat serta kemudahan logistik equipment berat.
      </p>
    </div>
  </div>

  <!-- 10 Workshops Directory -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 font-sans">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border-t border-l border-slate-200 bg-white">
      {COMPANY_INFO.workshops.map((w, index) => {
        const branchWaUrl = generateGeneralInquiryUrl(`workshop-${w.id}`);
        const locCode = `LOC-${String(index + 1).padStart(2, '0')}`;
        return (
          <div
            id={w.id}
            class="p-6 sm:p-7 border-r border-b border-slate-200 hover:bg-slate-50/60 transition-colors flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400">
                  {locCode} • {w.region}
                </span>
                {w.isMainOffice && (
                  <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded-xs bg-brand-100 text-brand-800 border border-brand-200">
                    Kantor Pusat
                  </span>
                )}
              </div>

              <h2 class="text-base sm:text-lg font-bold text-slate-900 leading-snug">
                {w.name}
              </h2>

              <div class="mt-2.5 text-xs text-slate-600 space-y-1">
                <p class="text-slate-600 font-mono text-[11px]">
                  Lokasi: <span class="text-slate-900 font-semibold">{w.region}</span>
                </p>
                {w.area && (
                  <p class="text-[11px] font-mono text-brand-700 bg-brand-50 inline-block px-2 py-0.5 border border-brand-200 mt-1">
                    Luas Area: {w.area}
                  </p>
                )}
              </div>

              <div class="mt-5 pt-4 border-t border-slate-100">
                <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400 block mb-2">
                  Fasilitas &amp; Kemampuan:
                </span>
                <div class="flex flex-wrap gap-1.5">
                  {w.capabilities.map((cap) => (
                    <span class="px-2 py-0.5 rounded-xs text-[10px] font-mono bg-slate-50 border border-slate-200 text-slate-700">
                      {cap}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between gap-3">
              <a
                href={branchWaUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-700 hover:text-brand-900 transition-colors"
              >
                <span>Hubungi Workshop {w.region}</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <!-- On-Site Engineering Callout -->
    <div class="mt-12 p-8 sm:p-10 border border-slate-800 bg-[#090b10] text-white flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="max-w-2xl space-y-2">
        <span class="text-[11px] font-mono uppercase tracking-wider text-brand-400 block">Mobile Field Engineering</span>
        <h3 class="text-xl sm:text-2xl font-bold text-white leading-snug">Equipment Tidak Dapat Dipindahkan ke Workshop?</h3>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          Kami menyediakan tim on-site field service lengkap dengan portable dynamic balancing, vibration analyzer, diagnostic test bench, dan peralatan machining in-situ untuk penanganan langsung di plant site Anda.
        </p>
      </div>
      <a
        href="/request-quotation/"
        class="px-6 py-3 rounded-sm bg-brand-600 hover:bg-brand-500 text-white font-semibold text-xs uppercase tracking-wider shrink-0 transition-colors shadow-xs"
      >
        <span>Ajukan On-Site Service &rarr;</span>
      </a>
    </div>

  </div>
</BaseLayout>
