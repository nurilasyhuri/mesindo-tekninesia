---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RfqForm from '../../components/rfq/RfqForm';
import { COMPANY_INFO } from '../../data/companyInfo';
---

<BaseLayout
  title="Request Quotation (RFQ) - Penawaran Teknis Equipment"
  description="Formulir resmi permohonan penawaran teknis (RFQ) repair, rewinding, overhaul, balancing, dan machining peralatan industri PT Mesindo Tekninesia."
>
  <!-- Page Header -->
  <div class="bg-slate-50 border-b border-slate-200/80 py-10 sm:py-14 px-4 sm:px-6 lg:px-8 font-sans">
    <div class="max-w-4xl mx-auto text-center">
      <span class="text-xs font-bold text-brand-700 uppercase tracking-wider block mb-2">
        Layanan Penawaran Resmi &bull; B2B Engineering
      </span>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Permohonan Penawaran Teknis (RFQ)
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 mt-2 max-w-2xl mx-auto leading-relaxed">
        Sampaikan data teknis equipment industri Anda untuk memperoleh estimasi biaya, kajian teknis pendahuluan, dan ketersediaan workshop terdekat.
      </p>
    </div>
  </div>

  <!-- Main RFQ Form Container -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 font-sans">
    <RfqForm client:load />

    <!-- Help Notice -->
    <div class="mt-8 p-6 rounded-2xl bg-slate-50 border border-slate-200/80 text-center space-y-2">
      <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider">
        Butuh Penanganan Emergency atau On-Site Assessment Cepat?
      </h4>
      <p class="text-xs text-slate-600">
        Hubungi hotline technical support kami langsung di <strong class="text-slate-900">{COMPANY_INFO.contact.phoneFormatted}</strong> atau email ke <strong class="text-slate-900">{COMPANY_INFO.contact.salesEmail}</strong>.
      </p>
    </div>
  </div>
</BaseLayout>
