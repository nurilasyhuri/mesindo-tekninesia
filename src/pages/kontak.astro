---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY_INFO } from '../data/companyInfo';
import { generateGeneralInquiryUrl } from '../utils/whatsapp';

const waContactUrl = generateGeneralInquiryUrl('page-kontak');
---

<BaseLayout
  title="Hubungi Tim Engineering Workshop - MESINDO TEKNISIA"
  description="Kontak resmi MESINDO TEKNISIA, kantor pusat Jakarta Utara, email engineering, serta layanan konsultasi teknisi darurat 24/7."
>
  <!-- Page Header -->
  <div class="bg-slate-50 border-b border-slate-200/80 py-12 sm:py-16 px-4 sm:px-6 lg:px-8 font-sans">
    <div class="max-w-7xl mx-auto">
      <span class="text-xs font-bold text-brand-700 uppercase tracking-wider block mb-2">
        Hubungi Tim Engineering
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
        Kontak &amp; Informasi Layanan
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 mt-3 max-w-3xl leading-relaxed">
        Tim technical support MESINDO TEKNISIA siap membantu kebutuhan audit kelistrikan, rekondisi darurat, hingga perencanaan overhaul equipment industri Anda.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 font-sans">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Contact Details Dossier (Left Column) -->
      <div class="lg:col-span-5 border border-slate-200 bg-white divide-y divide-slate-200">
        <div class="p-6 sm:p-8 space-y-3">
          <span class="text-[11px] font-mono uppercase tracking-wider text-slate-400 block">Headquarters &amp; Main Facility</span>
          <h3 class="text-base font-bold text-slate-900">
            {COMPANY_INFO.name}
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed font-mono text-[11px]">
            Lokasi: <span class="text-slate-900 font-semibold">DKI Jakarta, Indonesia</span> (Melayani Klien Seluruh Indonesia)
          </p>
          <div class="pt-2">
            <span class="text-[11px] font-mono text-brand-700 bg-brand-50 inline-block px-2 py-0.5 border border-brand-200">
              Lahan Workshop: 25.000 m² (10.000 m² Indoor)
            </span>
          </div>
        </div>

        <div class="p-6 sm:p-8 space-y-4">
          <span class="text-[11px] font-mono uppercase tracking-wider text-slate-400 block">Direct Lines &amp; Support</span>
          <div class="space-y-3 text-xs">
            <div class="flex items-start justify-between gap-4 pb-2.5 border-b border-slate-100">
              <span class="text-slate-500 font-mono">Telepon Kantor</span>
              <a href="tel:+6285183002070" class="text-slate-900 font-bold hover:text-brand-600 transition-colors font-mono">
                {COMPANY_INFO.contact.phoneFormatted}
              </a>
            </div>
            <div class="flex items-start justify-between gap-4 pb-2.5 border-b border-slate-100">
              <span class="text-slate-500 font-mono">Emergency Hotline</span>
              <a href={waContactUrl} target="_blank" rel="noopener noreferrer" class="text-brand-700 font-bold hover:underline font-mono">
                {COMPANY_INFO.contact.mobileFormatted}
              </a>
            </div>
            <div class="flex items-start justify-between gap-4 pb-2.5 border-b border-slate-100">
              <span class="text-slate-500 font-mono">Workshop Manager</span>
              <span class="text-slate-800 font-semibold">{COMPANY_INFO.contact.workshopManager}</span>
            </div>
            <div class="flex items-start justify-between gap-4">
              <span class="text-slate-500 font-mono">Email Resmi</span>
              <div class="text-right">
                <div class="font-mono text-slate-800">{COMPANY_INFO.contact.email}</div>
                <div class="font-mono text-slate-500 text-[11px]">{COMPANY_INFO.contact.salesEmail}</div>
              </div>
            </div>
          </div>
        </div>

        <div class="p-6 sm:p-8 bg-slate-900 text-white space-y-2">
          <div class="flex items-center justify-between">
            <h4 class="text-sm font-bold text-white">Jaringan 10 Workshop Nasional</h4>
            <span class="text-[10px] font-mono text-brand-400 uppercase">Coverage</span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed">
            Dari Jawa, Sumatera, Sulawesi hingga Papua untuk mobilisasi peralatan berat dan on-site testing.
          </p>
          <div class="pt-2">
            <a
              href="/lokasi-workshop/"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-400 hover:text-brand-300 transition-colors"
            >
              <span>Lihat Seluruh 10 Cabang &rarr;</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Quick Inquiry / RFQ Console (Right Column) -->
      <div class="lg:col-span-7 border border-slate-200 bg-white p-8 sm:p-10 space-y-8">
        <div>
          <span class="text-[11px] font-mono uppercase tracking-wider text-slate-400 block mb-1">Technical Inquiry Desk</span>
          <h2 class="text-2xl font-bold text-slate-900 tracking-tight">Kanal Permohonan Penawaran &amp; Konsultasi</h2>
          <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
            Untuk permintaan penawaran harga resmi (Quotation), verifikasi nameplate motor/trafo, atau koordinasi penanganan darurat (emergency breakdown).
          </p>
        </div>

        <div class="space-y-6">
          <!-- Option A: Formal RFQ -->
          <div class="border-t border-slate-200 pt-6 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-semibold text-slate-900">Formulir RFQ Resmi</span>
              <span class="text-[10px] font-mono text-slate-400 uppercase">Multi-Item RFQ</span>
            </div>
            <h3 class="text-base font-bold text-slate-900">Permohonan RFQ Online (Nameplate &amp; Scope)</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Direkomendasikan untuk pengadaan B2B yang membutuhkan estimasi formal. Lengkapi spesifikasi daya (kW/HP), tegangan (Volt), putaran (RPM), dan scope kerusakan.
            </p>
            <div class="pt-1">
              <a
                href="/request-quotation/"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-sm bg-slate-900 hover:bg-brand-600 text-white font-semibold text-xs tracking-wide transition-all shadow-xs"
              >
                <span>Buka Formulir RFQ Online</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>

          <!-- Option B: Direct WhatsApp Desk -->
          <div class="border-t border-slate-200 pt-6 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-semibold text-emerald-700">Hotline Respon Cepat</span>
              <span class="text-[10px] font-mono text-slate-400 uppercase">Technical Support</span>
            </div>
            <h3 class="text-base font-bold text-slate-900">Hotline Teknis &amp; Verifikasi Cepat WhatsApp</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Kirimkan foto nameplate, audio getaran tidak wajar, atau foto kerusakan equipment langsung ke teknisi jaga untuk penanganan awal.
            </p>
            <div class="pt-1">
              <a
                href={waContactUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-sm bg-brand-600 hover:bg-brand-500 text-white font-semibold text-xs tracking-wide transition-all shadow-xs"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
                </svg>
                <span>Chat Technical Support ({COMPANY_INFO.contact.phoneFormatted})</span>
              </a>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</BaseLayout>
