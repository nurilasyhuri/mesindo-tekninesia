---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustPartnersStrip from '../../components/home/TrustPartnersStrip.astro';

const facilities = await getCollection('fasilitas');
facilities.sort((a, b) => a.data.orderPriority - b.data.orderPriority);
---

<BaseLayout
  title="Katalog Fasilitas Mesin & Kapasitas Engineering - PT Mesindo Tekninesia"
  description="Fasilitas permesinan dan pengujian raksasa: High Speed Balancing 150 Ton, Vertical Lathe 6.7m x 8m, Horizontal Lathe 15m, VPI Chamber Class H, dan Test Bench 15kV."
>
  <!-- Shopify Collection Header -->
  <div class="bg-industrial-950 text-white border-b border-industrial-800 py-12 sm:py-16 px-4 sm:px-6 lg:px-8 font-sans relative overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-20">
      <img
        src="/images/hero-industrial.webp"
        alt="Fasilitas Workshop Mesindo"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-industrial-950 via-industrial-950/90 to-industrial-950/70"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto">
      <nav class="flex items-center gap-2 text-xs text-slate-400 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Beranda</a>
        <span>/</span>
        <span class="text-brand-300 font-semibold">Katalog Fasilitas Workshop</span>
      </nav>

      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div class="max-w-3xl">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-brand-500/20 text-brand-300 border border-brand-500/30 mb-3">
            Heavy Machinery Catalog &bull; Standar EASA &amp; IEEE
          </span>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
            Kapasitas Mesin &amp; Tooling Berdimensi Raksasa
          </h1>
          <p class="text-xs sm:text-sm text-slate-300 mt-3 leading-relaxed max-w-2xl">
            Investasi berkelanjutan PT Mesindo Tekninesia pada mesin bubut vertikal 6.7m, bubut horizontal 15m, terowongan balancing 150 ton, dan tangki VPI memungkinkan penanganan equipment industri berat secara mandiri di dalam negeri.
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0">
          <button
            type="button"
            onclick="window.openRfqDrawer ? window.openRfqDrawer() : null"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-brand-600 hover:bg-brand-500 text-white font-bold text-xs uppercase tracking-wider transition-all shadow-md cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            <span>Buka Keranjang RFQ</span>
            <span class="rfq-cart-count hidden px-1.5 py-0.5 rounded-full bg-white text-brand-800 text-[10px] font-mono font-bold leading-none">0</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Trust Certification Strip -->
  <TrustPartnersStrip />

  <!-- Facilities Catalog List (Shopify B2B Product Layout) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 font-sans space-y-12 sm:space-y-16">
    {facilities.map((fac, idx) => {
      const isReversed = idx % 2 === 1;
      const sku = `FAC-MT-${fac.slug.slice(0, 4).toUpperCase()}`;

      return (
        <section class="bg-white rounded-3xl border border-slate-200/90 overflow-hidden shadow-2xs p-6 sm:p-10 transition-all hover:shadow-lg hover:border-slate-300">
          <div class={`grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center ${isReversed ? 'lg:grid-flow-dense' : ''}`}>
            
            <!-- Media Frame (5 Cols) -->
            <div class={`lg:col-span-6 rounded-2xl overflow-hidden border border-slate-200 bg-slate-100 relative aspect-[4/3] ${isReversed ? 'lg:col-start-7' : ''}`}>
              <img
                src={fac.data.coverImage}
                alt={fac.data.title}
                class="w-full h-full object-cover"
                loading="lazy"
                decoding="async"
              />
              
              <!-- Badges -->
              <div class="absolute top-3 inset-x-3 flex items-center justify-between pointer-events-none">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-950/85 text-emerald-300 backdrop-blur-xs border border-emerald-500/30">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span>Operasional Workshop</span>
                </span>
                <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-slate-950/85 text-white backdrop-blur-xs">
                  {fac.data.category}
                </span>
              </div>
            </div>

            <!-- Content Area (6 Cols) -->
            <div class={`lg:col-span-6 space-y-5 ${isReversed ? 'lg:col-start-1' : ''}`}>
              <div>
                <div class="flex items-center justify-between text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-2">
                  <span>PT MESINDO TEKNINESIA</span>
                  <span>SKU: {sku}</span>
                </div>

                <h2 class="text-xl sm:text-3xl font-extrabold text-slate-950 leading-tight">
                  {fac.data.title}
                </h2>

                <div class="mt-3 inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-brand-50 border border-brand-200/80 text-brand-800 font-mono text-xs font-bold">
                  <span class="w-2 h-2 rounded-full bg-brand-600"></span>
                  <span>Kapasitas: {fac.data.capacity}</span>
                </div>
              </div>

              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {fac.data.description}
              </p>

              <!-- Technical Specifications Grid -->
              {fac.data.specs && (
                <div class="pt-3 border-t border-slate-100">
                  <span class="text-[11px] font-bold text-slate-900 uppercase tracking-wider block mb-2.5">
                    Data Teknis &amp; Dimensi Maksimal:
                  </span>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                    {Object.entries(fac.data.specs).map(([specKey, specVal]) => (
                      <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/70">
                        <span class="text-[10px] uppercase font-semibold text-slate-400 block">{specKey}</span>
                        <span class="font-bold text-slate-900 block mt-0.5">{specVal}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              <!-- Shopify Action Buttons -->
              <div class="pt-3 flex flex-wrap items-center gap-3">
                <button
                  type="button"
                  data-add-rfq
                  data-rfq-id={`fac-${fac.slug}`}
                  data-rfq-title={`Inquiry Fasilitas: ${fac.data.title}`}
                  data-rfq-category={fac.data.category}
                  data-rfq-spec={`Kapasitas: ${fac.data.capacity}`}
                  data-rfq-image={fac.data.coverImage}
                  data-rfq-qty="1"
                  class="inline-flex items-center justify-center gap-2 py-3 px-5 rounded-xl bg-slate-950 hover:bg-brand-600 text-white font-bold text-xs uppercase tracking-wider shadow-sm transition-all cursor-pointer select-none"
                >
                  <svg class="w-4 h-4 text-brand-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                  </svg>
                  <span>+ Tambah Fasilitas ke RFQ</span>
                </button>

                <a
                  href={`https://wa.me/6285183002070?text=${encodeURIComponent(`Halo Tim Mesindo, saya ingin menanyakan jadwal dan kapasitas fasilitas *${fac.data.title}* (${fac.data.capacity}).`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-white border border-slate-300 hover:border-slate-400 text-slate-800 font-bold text-xs uppercase tracking-wider transition-all"
                >
                  <svg class="w-4 h-4 text-emerald-600 fill-current" viewBox="0 0 24 24">
                    <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
                  </svg>
                  <span>Cek Ketersediaan Slot</span>
                </a>
              </div>
            </div>

          </div>
        </section>
      );
    })}
  </div>
</BaseLayout>
