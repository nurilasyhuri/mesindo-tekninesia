---
import { getCollection } from 'astro:content';

const services = await getCollection('layanan');
services.sort((a, b) => a.data.orderPriority - b.data.orderPriority);

const filterTabs = [
  { id: 'all', label: 'Semua Layanan', count: services.length },
  { id: 'electrical', label: 'Rotating & Electrical', count: services.filter(s => s.data.category === 'electrical').length },
  { id: 'balancing', label: 'Dynamic Balancing', count: services.filter(s => s.data.category === 'balancing').length },
  { id: 'machining', label: 'Machining & Mechanical', count: services.filter(s => s.data.category === 'machining' || s.data.category === 'mechanical').length },
  { id: 'testing', label: 'Testing NDT', count: services.filter(s => s.data.category === 'testing').length },
  { id: 'component', label: 'Komponen & Coil', count: services.filter(s => s.data.category === 'component').length },
];
---

<section id="katalog-layanan" class="py-20 sm:py-28 bg-white font-sans select-none">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Apple Style) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div class="max-w-2xl">
        <span class="text-xs font-semibold uppercase tracking-[0.15em] text-sky-600 block mb-2">
          Jasa Rekayasa Workshop &amp; On-Site Nasional
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-950 tracking-tight leading-tight">
          Layanan Bengkel Overhaul &amp; Rewinding Presisi.
        </h2>
        <p class="text-sm sm:text-base text-slate-500 mt-3 leading-relaxed">
          Penyedia jasa rewinding motor listrik LV/HV 13.8kV, overhaul generator &amp; turbin, dynamic balancing rotor 150 ton ISO 1940, bubut vertikal 6.7m, serta pengujian diagnostik NDT di seluruh Indonesia.
        </p>
      </div>

      <!-- Quick Action -->
      <div class="flex items-center gap-3 shrink-0">
        <a
          href="/request-quotation/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-900 hover:bg-black text-white text-xs font-medium tracking-tight transition-all"
        >
          <span>Form RFQ Resmi</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Category Filter Tabs (Apple Pill Segmented Control) -->
    <div class="flex items-center overflow-x-auto pb-4 mb-10 no-scrollbar" role="tablist" aria-label="Filter Kategori Layanan">
      <div class="inline-flex p-1 rounded-full bg-slate-100 border border-slate-200/60 gap-1">
        {filterTabs.map((tab, idx) => (
          <button
            type="button"
            data-filter-tab={tab.id}
            class:list={[
              'collection-filter-tab px-4 py-1.5 rounded-full text-xs font-medium whitespace-nowrap transition-all cursor-pointer select-none',
              idx === 0
                ? 'bg-white text-slate-950 shadow-xs font-semibold'
                : 'text-slate-600 hover:text-slate-950'
            ]}
          >
            <span>{tab.label}</span>
            <span class="ml-1 opacity-50 text-[11px] font-mono">({tab.count})</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Services Grid (Apple Bento Cards) -->
    <div id="services-collection-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map((service) => {
        const firstSpec = service.data.keySpecs[0] || 'Standar IEEE & IEC';
        const secondSpec = service.data.keySpecs[1] || 'Workshop & On-Site Ready';
        
        const filterGroup = (service.data.category === 'machining' || service.data.category === 'mechanical') 
          ? 'machining' 
          : service.data.category;

        return (
          <article
            data-category={filterGroup}
            class="service-card bg-[#fbfbfd] rounded-2xl border border-slate-200/70 overflow-hidden hover:border-slate-300 hover:shadow-xl transition-all duration-300 flex flex-col justify-between group"
          >
            <div>
              <!-- Image Frame -->
              <div class="relative aspect-[16/10] overflow-hidden bg-slate-100">
                <img
                  src={service.data.heroImage}
                  alt={service.data.title}
                  class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500 ease-out"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute top-3 left-3">
                  <span class="px-2.5 py-1 rounded-full text-[10px] font-medium bg-black/60 text-white backdrop-blur-md">
                    {service.data.categoryLabel}
                  </span>
                </div>
              </div>

              <!-- Content -->
              <div class="p-6">
                <h3 class="text-lg font-semibold text-slate-950 group-hover:text-sky-600 transition-colors leading-snug tracking-tight">
                  <a href={`/layanan/${service.slug}/`}>
                    {service.data.title}
                  </a>
                </h3>

                <p class="text-xs sm:text-sm text-slate-500 mt-2 leading-relaxed line-clamp-2">
                  {service.data.description}
                </p>

                <!-- Technical Specs Snippet -->
                <div class="mt-5 pt-4 border-t border-slate-200/60 space-y-1.5 text-xs text-slate-600">
                  <div class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-400 shrink-0"></span>
                    <span class="line-clamp-1 font-medium text-slate-700">{firstSpec}</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-400 shrink-0"></span>
                    <span class="line-clamp-1 text-slate-500">{secondSpec}</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Card Actions -->
            <div class="p-6 pt-0 border-t border-slate-100 mt-2 flex items-center justify-between gap-3">
              <a
                href={`/layanan/${service.slug}/`}
                class="text-xs font-medium text-slate-600 hover:text-black inline-flex items-center gap-1 transition-colors"
              >
                <span>Pelajari Layanan</span>
                <span>&rarr;</span>
              </a>

              <button
                type="button"
                data-add-rfq
                data-rfq-id={service.slug}
                data-rfq-title={service.data.title}
                data-rfq-category={service.data.categoryLabel}
                data-rfq-spec={firstSpec}
                data-rfq-image={service.data.heroImage}
                data-rfq-qty="1"
                class="px-3.5 py-1.5 rounded-full bg-white hover:bg-slate-950 hover:text-white text-slate-900 border border-slate-200 text-xs font-medium transition-all shadow-xs cursor-pointer"
                title="Tambah ke Keranjang RFQ"
              >
                + Tambah ke RFQ
              </button>
            </div>
          </article>
        );
      })}
    </div>

  </div>
</section>

<script is:inline>
  (function() {
    const tabs = document.querySelectorAll('.collection-filter-tab');
    const cards = document.querySelectorAll('.service-card');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('bg-white', 'text-slate-950', 'shadow-xs', 'font-semibold');
          t.classList.add('text-slate-600');
        });
        tab.classList.add('bg-white', 'text-slate-950', 'shadow-xs', 'font-semibold');
        tab.classList.remove('text-slate-600');

        const filterId = tab.dataset.filterTab;

        cards.forEach((card) => {
          const cardCategory = card.dataset.category;
          if (filterId === 'all' || cardCategory === filterId) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  })();
</script>
