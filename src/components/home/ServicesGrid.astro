---
import { getCollection } from 'astro:content';

const services = await getCollection('layanan');
services.sort((a, b) => a.data.orderPriority - b.data.orderPriority);

const filterTabs = [
  { id: 'all', label: 'Semua Koleksi', count: services.length },
  { id: 'electrical', label: 'Rotating & Electrical', count: services.filter(s => s.data.category === 'electrical').length },
  { id: 'balancing', label: 'Dynamic Balancing', count: services.filter(s => s.data.category === 'balancing').length },
  { id: 'machining', label: 'Machining & Mechanical', count: services.filter(s => s.data.category === 'machining' || s.data.category === 'mechanical').length },
  { id: 'testing', label: 'Testing & NDT', count: services.filter(s => s.data.category === 'testing').length },
  { id: 'component', label: 'Coil & Komponen', count: services.filter(s => s.data.category === 'component').length },
];
---

<section id="katalog-layanan" class="py-16 sm:py-24 bg-slate-50 font-sans border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Shopify Collection Header) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 pb-6 border-b border-slate-200/80 gap-6">
      <div class="max-w-2xl">
        <span class="text-[11px] font-bold text-brand-700 uppercase tracking-widest block mb-2">
          B2B Engineering Catalog • Workshop &amp; On-Site Services
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-950 tracking-tight">
          Koleksi Layanan Repair, Rewinding &amp; Overhaul
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-2.5 leading-relaxed">
          Pilih unit equipment, tentukan spesifikasi lingkup kerja, dan tambahkan ke Keranjang RFQ untuk mendapatkan estimasi penawaran teknis resmi berbasis nameplate.
        </p>
      </div>

      <!-- Quick RFQ Cart Action & Counter -->
      <div class="flex items-center gap-3 shrink-0">
        <button
          type="button"
          onclick="window.openRfqDrawer ? window.openRfqDrawer() : null"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white border border-slate-300 hover:border-slate-400 text-slate-800 text-xs font-bold uppercase tracking-wider shadow-2xs hover:shadow-xs transition-all cursor-pointer"
        >
          <svg class="w-4 h-4 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span>Keranjang RFQ</span>
          <span class="rfq-cart-count hidden px-1.5 py-0.5 rounded-full bg-brand-600 text-white text-[10px] font-mono font-bold leading-none">0</span>
        </button>

        <a
          href="/request-quotation/"
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-slate-950 hover:bg-brand-600 text-white text-xs font-bold uppercase tracking-wider transition-colors shadow-2xs"
        >
          <span>Form RFQ Formal</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Collection Filter Tabs (Shopify Collection Pills) -->
    <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 no-scrollbar" role="tablist" aria-label="Filter Kategori Layanan">
      {filterTabs.map((tab, idx) => (
        <button
          type="button"
          data-filter-tab={tab.id}
          class:list={[
            'collection-filter-tab px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all cursor-pointer select-none border',
            idx === 0
              ? 'bg-slate-950 text-white border-slate-950 shadow-2xs'
              : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-100 hover:border-slate-300'
          ]}
        >
          <span>{tab.label}</span>
          <span class="ml-1.5 opacity-60 text-[11px] font-mono">({tab.count})</span>
        </button>
      ))}
    </div>

    <!-- Shopify Product / Service Cards Grid -->
    <div id="services-collection-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {services.map((service) => {
        const sku = `MT-${service.slug.slice(0, 3).toUpperCase()}-2026`;
        const firstSpec = service.data.keySpecs[0] || 'Standar IEEE & IEC';
        const secondSpec = service.data.keySpecs[1] || 'Workshop & On-Site Ready';
        
        // Group machining & mechanical together for filter compatibility
        const filterGroup = (service.data.category === 'machining' || service.data.category === 'mechanical') 
          ? 'machining' 
          : service.data.category;

        return (
          <article
            data-category={filterGroup}
            class="service-card bg-white rounded-2xl border border-slate-200/90 overflow-hidden shadow-2xs hover:shadow-lg hover:border-slate-300 transition-all duration-300 flex flex-col justify-between group"
          >
            <div>
              <!-- Product Media Frame with Shopify Aspect Ratio -->
              <div class="relative aspect-[4/3] overflow-hidden bg-slate-100 border-b border-slate-100">
                <img
                  src={service.data.heroImage}
                  alt={service.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                  loading="lazy"
                  decoding="async"
                />

                <!-- Top Status Badges -->
                <div class="absolute top-3 inset-x-3 flex items-center justify-between pointer-events-none">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-950/85 text-emerald-300 backdrop-blur-xs border border-emerald-500/30">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>Ready Workshop</span>
                  </span>

                  <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-slate-950/80 text-white backdrop-blur-xs">
                    {service.data.categoryLabel}
                  </span>
                </div>

                <!-- Quick Add Hover Overlay Button (Shopify Quick ATC) -->
                <div class="absolute inset-x-3 bottom-3 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                  <button
                    type="button"
                    data-add-rfq
                    data-rfq-id={service.slug}
                    data-rfq-title={service.data.title}
                    data-rfq-category={service.data.categoryLabel}
                    data-rfq-spec={firstSpec}
                    data-rfq-image={service.data.heroImage}
                    data-rfq-qty="1"
                    class="w-full py-2.5 px-3 rounded-xl bg-slate-950/90 hover:bg-brand-600 text-white font-bold text-xs uppercase tracking-wider shadow-lg backdrop-blur-xs flex items-center justify-center gap-2 transition-all cursor-pointer"
                  >
                    <svg class="w-4 h-4 text-brand-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                    </svg>
                    <span>+ Quick Tambah ke RFQ</span>
                  </button>
                </div>
              </div>

              <!-- Product Details -->
              <div class="p-5">
                <!-- Vendor & SKU Identifier -->
                <div class="flex items-center justify-between text-[10px] font-semibold text-slate-400 uppercase tracking-wider mb-1.5">
                  <span>PT MESINDO TEKNINESIA</span>
                  <span class="font-mono text-slate-500">{sku}</span>
                </div>

                <!-- Title -->
                <h3 class="text-base font-extrabold text-slate-950 group-hover:text-brand-700 transition-colors leading-snug">
                  <a href={`/layanan/${service.slug}/`}>
                    {service.data.title}
                  </a>
                </h3>

                <!-- Rating Review Snippet (Shopify Trust Element) -->
                <div class="flex items-center gap-1.5 mt-2">
                  <div class="flex text-amber-400 text-xs">
                    <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
                  </div>
                  <span class="text-[11px] font-bold text-slate-700">5.0</span>
                  <span class="text-[11px] text-slate-400">(Uji FAT Lulus)</span>
                </div>

                <!-- Technical Capacity Chips -->
                <div class="mt-3.5 space-y-1.5">
                  <div class="p-2 rounded-lg bg-slate-50 border border-slate-100 text-[11px] text-slate-600 flex items-start gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-600 shrink-0 mt-1"></span>
                    <span class="line-clamp-1 font-medium">{firstSpec}</span>
                  </div>
                  <div class="p-2 rounded-lg bg-slate-50 border border-slate-100 text-[11px] text-slate-600 flex items-start gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-400 shrink-0 mt-1"></span>
                    <span class="line-clamp-1">{secondSpec}</span>
                  </div>
                </div>

                <!-- Price / Commercial Terms -->
                <div class="mt-4 pt-3 border-t border-slate-100 flex items-baseline justify-between">
                  <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Estimasi:</span>
                  <span class="text-xs font-bold text-brand-700 font-mono">Inquiry by Nameplate (RFQ)</span>
                </div>
              </div>
            </div>

            <!-- Card Bottom Actions -->
            <div class="px-5 pb-5 pt-1 grid grid-cols-2 gap-2">
              <button
                type="button"
                data-add-rfq
                data-rfq-id={service.slug}
                data-rfq-title={service.data.title}
                data-rfq-category={service.data.categoryLabel}
                data-rfq-spec={firstSpec}
                data-rfq-image={service.data.heroImage}
                data-rfq-qty="1"
                class="inline-flex items-center justify-center gap-1.5 py-2.5 px-2 rounded-xl bg-brand-50 hover:bg-brand-600 text-brand-700 hover:text-white font-bold text-[11px] uppercase tracking-wider border border-brand-200/80 hover:border-transparent transition-all cursor-pointer"
                title="Tambah ke Keranjang RFQ"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
                <span>+ RFQ</span>
              </button>

              <a
                href={`/layanan/${service.slug}/`}
                class="inline-flex items-center justify-center gap-1 py-2.5 px-2 rounded-xl bg-slate-100 hover:bg-slate-900 text-slate-800 hover:text-white font-bold text-[11px] uppercase tracking-wider transition-all"
              >
                <span>Spesifikasi</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>

  </div>
</section>

<!-- Client Filter Tab Switcher Script -->
<script is:inline>
  (function () {
    const tabs = document.querySelectorAll('.collection-filter-tab');
    const cards = document.querySelectorAll('.service-card');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-filter-tab');

        // Update active tab styling
        tabs.forEach(t => {
          t.classList.remove('bg-slate-950', 'text-white', 'border-slate-950', 'shadow-2xs');
          t.classList.add('bg-white', 'text-slate-700', 'border-slate-200');
        });
        tab.classList.remove('bg-white', 'text-slate-700', 'border-slate-200');
        tab.classList.add('bg-slate-950', 'text-white', 'border-slate-950', 'shadow-2xs');

        // Filter cards
        cards.forEach(card => {
          const cat = card.getAttribute('data-category');
          if (filter === 'all' || cat === filter) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  })();
</script>
