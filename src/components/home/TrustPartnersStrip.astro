<section class="bg-[#f5f5f7] py-10 sm:py-14 font-sans select-none">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8">
      
      <!-- Left Context -->
      <div class="max-w-lg">
        <span class="text-[11px] font-medium uppercase tracking-[0.15em] text-slate-500 block mb-1">
          Otorisasi &amp; Kredensial Global
        </span>
        <h3 class="text-xl sm:text-2xl font-semibold text-slate-900 tracking-tight leading-snug">
          Authorized Partner TECO &amp; Goltens
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
          Anggota resmi internasional <span class="font-medium text-slate-900">EASA</span> &amp; <span class="font-medium text-slate-900">AEMT</span>, serta tersertifikasi penuh ISO 9001:2015, ISO 14001:2015, dan ISO 45001:2018 untuk jaminan mutu perbaikan equipment industri.
        </p>
      </div>

      <!-- Right: Authentic Partner & ISO Banner (Seamless, no card wrapper) -->
      <div class="flex items-center justify-center lg:justify-end">
        <img
          src="/images/partners-certifications.webp"
          alt="Sertifikasi ISO 9001, ISO 14001, ISO 45001, Authorized Agent TECO, Goltens, Anggota EASA, AEMT - MESINDO TEKNISIA"
          class="max-h-12 sm:max-h-14 w-auto object-contain filter grayscale hover:grayscale-0 transition-all duration-300"
          loading="lazy"
        />
      </div>

    </div>
  </div>
</section>
