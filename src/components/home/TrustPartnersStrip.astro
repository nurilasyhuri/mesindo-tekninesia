<section class="bg-white border-b border-slate-200/90 py-8 sm:py-10 font-sans">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
      
      <!-- Left Context -->
      <div class="max-w-md">
        <span class="text-[10px] font-bold uppercase tracking-widest text-brand-700 block mb-1">
          Kredensial &amp; Otorisasi Resmi
        </span>
        <h3 class="text-base font-extrabold text-slate-900 leading-snug">
          Authorized Agent &amp; Standar Mutu Global
        </h3>
        <p class="text-xs text-slate-600 mt-1.5 leading-relaxed">
          Authorized Agent &amp; Partner resmi <span class="font-bold text-slate-800">TECO</span> dan <span class="font-bold text-slate-800">Goltens</span>, anggota internasional <span class="font-bold text-slate-800">EASA</span> &amp; <span class="font-bold text-slate-800">AEMT</span>, tersertifikasi penuh ISO 9001:2015, ISO 14001:2015, dan ISO 45001:2018.
        </p>
      </div>

      <!-- Right: Authentic Partner & ISO Banner from mesindotekninesia.com -->
      <div class="p-3 sm:p-4 rounded-2xl bg-slate-50 border border-slate-200/80 flex items-center justify-center shadow-2xs">
        <img
          src="/images/partners-certifications.webp"
          alt="Sertifikasi ISO 9001, ISO 14001, ISO 45001, Authorized Agent TECO, Goltens, Anggota EASA, AEMT - PT Mesindo Tekninesia"
          class="max-h-16 sm:max-h-20 w-auto object-contain"
          loading="lazy"
        />
      </div>

    </div>
  </div>
</section>
