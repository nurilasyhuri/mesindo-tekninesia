---
import { getCollection } from 'astro:content';

const projects = await getCollection('proyek');
---

<section class="py-20 sm:py-28 bg-[#f5f5f7] font-sans select-none">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Apple Style) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div class="max-w-2xl">
        <span class="text-xs font-semibold uppercase tracking-[0.15em] text-sky-600 block mb-2">
          Portofolio Proyek Rekayasa Industri &amp; Pembangkit
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-950 tracking-tight leading-tight">
          Studi Kasus Overhaul Generator &amp; Motor HV.
        </h2>
        <p class="text-sm sm:text-base text-slate-500 mt-3 leading-relaxed">
          Dokumentasi pengerjaan overhaul generator 150MW PLTU, rewinding motor tegangan tinggi 6.6kV pabrik semen, purifikasi minyak trafo 60 MVA kilang minyak, dan balancing rotor turbin berstandar ISO 9001.
        </p>
      </div>

      <a
        href="/proyek/"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-900 hover:bg-black text-white text-xs font-medium tracking-tight transition-all shrink-0"
      >
        <span>Semua Studi Kasus</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <!-- Projects Matrix (Kurangi Card: Shared Hairline Grid, Zero Nested Mini-Cards) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 border-t border-l border-slate-200 bg-white">
      {projects.map((proj) => (
        <article class="border-r border-b border-slate-200 p-6 sm:p-8 flex flex-col justify-between hover:bg-slate-50/50 transition-colors group">
          <div>
            <!-- Media Frame -->
            <div class="relative aspect-[16/9] overflow-hidden bg-slate-100 mb-6">
              <img
                src={proj.data.coverImage}
                alt={proj.data.title}
                class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-500 ease-out"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute top-3 left-3 flex gap-2">
                <span class="px-2 py-0.5 text-[9px] font-mono font-medium uppercase tracking-wider bg-slate-950/80 text-white backdrop-blur-xs">
                  {proj.data.sector}
                </span>
                <span class="px-2 py-0.5 text-[9px] font-mono font-medium uppercase tracking-wider bg-black/60 text-slate-200 backdrop-blur-xs">
                  {proj.data.location}
                </span>
              </div>
            </div>

            <div>
              <div class="text-[11px] font-mono text-slate-400 mb-1.5 uppercase tracking-wider">
                Equipment: {proj.data.equipment}
              </div>

              <h3 class="text-lg font-semibold text-slate-950 group-hover:text-sky-700 transition-colors leading-snug tracking-tight">
                <a href="/proyek/">
                  {proj.data.title}
                </a>
              </h3>

              <p class="text-xs sm:text-sm text-slate-600 mt-2.5 line-clamp-2 leading-relaxed">
                {proj.data.scope}
              </p>

              <!-- Typographic Metrics (Zero Nested Cards) -->
              {proj.data.metrics && (
                <div class="grid grid-cols-2 gap-4 mt-6 pt-5 border-t border-slate-100">
                  {proj.data.metrics.map((m) => (
                    <div>
                      <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400 block">{m.label}</span>
                      <span class="text-sm font-semibold text-slate-900 font-mono block mt-0.5">{m.value}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>

          <div class="pt-6 mt-6 border-t border-slate-100 flex items-center justify-between">
            <a
              href="/proyek/"
              class="text-xs font-semibold text-slate-800 hover:text-black inline-flex items-center gap-1.5 transition-colors"
            >
              <span>Pelajari Studi Kasus Penuh</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
