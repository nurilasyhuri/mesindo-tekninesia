---
import { getCollection } from 'astro:content';

const projects = await getCollection('proyek');
---

<section class="py-20 sm:py-28 bg-[#f5f5f7] font-sans select-none">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Apple Style) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div class="max-w-2xl">
        <span class="text-xs font-semibold uppercase tracking-[0.15em] text-sky-600 block mb-2">
          Portofolio Proyek Rekayasa Industri &amp; Pembangkit
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-950 tracking-tight leading-tight">
          Studi Kasus Overhaul Generator &amp; Motor HV.
        </h2>
        <p class="text-sm sm:text-base text-slate-500 mt-3 leading-relaxed">
          Dokumentasi pengerjaan overhaul generator 150MW PLTU, rewinding motor tegangan tinggi 6.6kV pabrik semen, purifikasi minyak trafo 60 MVA kilang minyak, dan balancing rotor turbin berstandar ISO 9001.
        </p>
      </div>

      <a
        href="/proyek/"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-900 hover:bg-black text-white text-xs font-medium tracking-tight transition-all shrink-0"
      >
        <span>Semua Studi Kasus</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <!-- Projects Grid in Apple Bento Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {projects.map((proj) => (
        <article class="bg-white rounded-2xl border border-slate-200/70 overflow-hidden hover:border-slate-300 hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="relative aspect-[16/9] overflow-hidden bg-slate-100">
              <img
                src={proj.data.coverImage}
                alt={proj.data.title}
                class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500 ease-out"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute top-3 left-3 flex gap-2">
                <span class="px-2.5 py-1 rounded-full text-[10px] font-medium bg-black/60 text-white backdrop-blur-md">
                  {proj.data.sector}
                </span>
                <span class="px-2.5 py-1 rounded-full text-[10px] font-medium bg-slate-900/70 text-slate-200 backdrop-blur-md">
                  {proj.data.location}
                </span>
              </div>
            </div>

            <div class="p-8">
              <div class="text-xs font-mono text-slate-400 mb-2">
                Equipment: {proj.data.equipment}
              </div>

              <h3 class="text-xl font-semibold text-slate-950 group-hover:text-sky-600 transition-colors leading-snug tracking-tight">
                {proj.data.title}
              </h3>

              <p class="text-xs sm:text-sm text-slate-500 mt-2.5 line-clamp-2 leading-relaxed">
                {proj.data.scope}
              </p>

              {proj.data.metrics && (
                <div class="grid grid-cols-2 gap-3 mt-6 pt-5 border-t border-slate-100">
                  {proj.data.metrics.map((m) => (
                    <div class="p-3.5 rounded-xl bg-[#f5f5f7] border border-slate-200/50">
                      <span class="text-[10px] text-slate-400 block uppercase tracking-wider">{m.label}</span>
                      <span class="text-sm font-semibold text-slate-900 font-mono block mt-1">{m.value}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>

          <div class="p-8 pt-0 border-t border-slate-100/60 mt-2">
            <a
              href="/proyek/"
              class="w-full inline-flex items-center justify-center gap-1.5 py-2.5 rounded-full bg-slate-100 group-hover:bg-slate-900 group-hover:text-white text-slate-800 font-medium text-xs transition-all"
            >
              <span>Pelajari Studi Kasus</span>
              <span>&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
