---
import { getCollection } from 'astro:content';

const projects = await getCollection('proyek');
---

<section class="py-16 sm:py-24 bg-slate-50 font-sans border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 pb-6 border-b border-slate-200/80 gap-4">
      <div class="max-w-2xl">
        <span class="text-xs font-bold text-brand-700 uppercase tracking-wider block mb-1">
          Pengalaman &amp; Studi Kasus
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
          Portofolio Pekerjaan Engineering Skala Besar
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
          Bukti nyata keandalan teknis kami dalam menangani kerusakan kompleks, overhaul terencana, dan rekondisi darurat equipment industri.
        </p>
      </div>

      <a
        href="/proyek/"
        class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-700 hover:text-brand-800 transition-colors uppercase tracking-wider shrink-0"
      >
        <span>Lihat Semua Studi Kasus</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((proj) => (
        <article class="bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-2xs hover:shadow-md transition-all flex flex-col justify-between group">
          <div>
            <div class="relative h-56 overflow-hidden bg-slate-100">
              <img
                src={proj.data.coverImage}
                alt={proj.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute top-3 left-3 flex gap-2">
                <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-slate-950/80 text-white backdrop-blur-xs">
                  {proj.data.sector}
                </span>
                <span class="px-2.5 py-1 rounded-full text-[10px] font-semibold bg-brand-600/90 text-white backdrop-blur-xs">
                  {proj.data.location}
                </span>
              </div>
            </div>

            <div class="p-6">
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-700 transition-colors leading-snug">
                {proj.data.title}
              </h3>
              
              <div class="mt-2 text-xs text-slate-500">
                <span class="font-semibold text-slate-700">Equipment:</span> {proj.data.equipment}
              </div>

              <p class="text-xs text-slate-600 mt-2 line-clamp-2 leading-relaxed">
                {proj.data.scope}
              </p>

              {proj.data.metrics && (
                <div class="grid grid-cols-2 gap-2 mt-4 pt-4 border-t border-slate-100">
                  {proj.data.metrics.map((m) => (
                    <div class="p-2 rounded-lg bg-slate-50 border border-slate-100">
                      <span class="text-[10px] text-slate-400 block">{m.label}</span>
                      <span class="text-xs font-bold text-slate-900 font-mono block mt-0.5">{m.value}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>

          <div class="p-6 pt-0">
            <a
              href="/proyek/"
              class="w-full inline-flex items-center justify-center gap-1 py-2.5 rounded-xl bg-slate-100 group-hover:bg-brand-600 group-hover:text-white text-slate-800 font-semibold text-xs transition-colors"
            >
              <span>Pelajari Studi Kasus</span>
              <span>&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
