---
import { COMPANY_INFO } from '../../data/companyInfo';
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';

const waUrl = generateGeneralInquiryUrl('home-rfq-banner');
---

<section class="py-16 sm:py-24 bg-industrial-950 text-white font-sans relative overflow-hidden">
  <div class="absolute inset-0 z-0 opacity-10 bg-[radial-gradient(#38bdf8_1px,transparent_1px)] [background-size:20px_20px]"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-industrial-900/90 border border-industrial-800 rounded-3xl p-8 sm:p-12 lg:p-16 shadow-2xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        
        <!-- Left: Headline & Information Checklist -->
        <div>
          <span class="text-xs font-bold text-brand-400 uppercase tracking-wider block mb-2">
            Diskusikan Kerusakan &amp; Kebutuhan Equipment
          </span>
          <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight leading-tight">
            Membutuhkan Repair, Rewinding, atau Engineering Support?
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 mt-4 leading-relaxed">
            Sampaikan kondisi equipment atau kendala operasional yang terjadi. Tim engineer {COMPANY_INFO.name} siap memberikan kajian teknis, estimasi waktu pengerjaan, dan skema penawaran resmi.
          </p>

          <!-- Information checklist required -->
          <div class="mt-6 pt-6 border-t border-industrial-800">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block mb-3">
              Informasi yang dapat Anda lampirkan:
            </span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-300">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-400"></span>
                <span>Jenis Equipment &amp; Brand</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-400"></span>
                <span>Power / Kapasitas (kW/MW)</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-400"></span>
                <span>Tegangan Kerja (Voltage) &amp; RPM</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-400"></span>
                <span>Foto Nameplate &amp; Fisik Mesin</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-400"></span>
                <span>Gejala Kerusakan / Anomali</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-400"></span>
                <span>Lokasi Pabrik / Equipment</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Actions Box -->
        <div class="bg-industrial-950/80 p-6 sm:p-8 rounded-2xl border border-industrial-800 flex flex-col justify-between space-y-6">
          <div>
            <span class="inline-flex items-center gap-2 text-xs font-semibold text-brand-400 bg-brand-950/60 border border-brand-800 px-3 py-1 rounded-full mb-3">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-400 animate-pulse"></span>
              Respon Cepat Tim Engineering
            </span>
            <h3 class="text-xl font-bold text-white leading-snug">
              Kirim Permohonan Penawaran Teknis (RFQ)
            </h3>
            <p class="text-xs text-slate-400 mt-2 leading-relaxed">
              Gunakan formulir online kami untuk menyusun data equipment secara terstruktur, atau hubungi langsung hotline WhatsApp kami untuk konsultasi darurat.
            </p>
          </div>

          <div class="space-y-3 pt-4 border-t border-industrial-800">
            <a
              href="/request-quotation/"
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-brand-600 hover:bg-brand-500 text-white font-bold text-xs sm:text-sm uppercase tracking-wider shadow-lg shadow-brand-900/40 transition-all select-none"
            >
              <span>Buka Formulir Request Quotation</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>

            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-industrial-900 hover:bg-industrial-800 text-slate-200 border border-industrial-700 hover:border-slate-500 font-semibold text-xs sm:text-sm transition-all select-none"
            >
              <svg class="w-4 h-4 text-brand-400" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
              </svg>
              <span>Hubungi via WhatsApp ({COMPANY_INFO.contact.phoneFormatted})</span>
            </a>
          </div>

          <p class="text-[11px] text-slate-500 text-center">
            Melayani pekerjaan workshop di 9 cabang dan on-site engineering di seluruh Indonesia.
          </p>
        </div>

      </div>
    </div>
  </div>
</section>
