---
import { COMPANY_INFO } from '../../data/companyInfo';

const whatsappUrl = `https://wa.me/${COMPANY_INFO.contact.whatsapp}?text=${encodeURIComponent('Halo Tim Engineering MESINDO TEKNISIA, saya ingin konsultasi spesifikasi mesin & penawaran overhaul.')}`;
---

<section class="relative min-h-[92vh] flex items-center bg-[#07090e] text-white overflow-hidden font-sans select-none">
  <!-- Cinematic Full Background Canvas -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <img
      src="/images/hero-home-bg.webp"
      alt="Fasilitas Rekayasa Workshop Berat MESINDO TEKNISIA - Stator Rewinding & Balancing Rotor"
      class="w-full h-full object-cover object-center opacity-45 sm:opacity-50"
      loading="eager"
      decoding="async"
    />
    <!-- Deep Vignette & Contrast Control Gradients -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#07090e] via-[#07090e]/55 to-[#07090e]/75"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#07090e]/80 via-transparent to-[#07090e]/80"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 pt-24 sm:pt-32 pb-16 sm:pb-24">
    <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
      
      <!-- Apple Eyebrow Kicker with Pill Glow -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/[0.08] border border-white/[0.15] backdrop-blur-md mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-[11px] sm:text-xs font-semibold uppercase tracking-[0.18em] text-slate-200">
          {COMPANY_INFO.name} • Sejak {COMPANY_INFO.establishedYear} • Total Services
        </span>
      </div>

      <!-- Apple Keynote Headline with Primary SEO Intent -->
      <h1 class="text-3xl sm:text-5xl lg:text-7xl font-semibold tracking-tight text-white leading-[1.12] sm:leading-[1.08] text-balance drop-shadow-md">
        Overhaul &amp; Rewinding Motor Listrik, Generator &amp; Balancing Industri.
      </h1>

      <!-- Apple Subheadline with Rich Industrial Keywords -->
      <p class="text-sm sm:text-lg lg:text-xl text-slate-300 font-normal leading-relaxed mt-5 sm:mt-6 max-w-3xl text-balance drop-shadow-sm">
        Layanan terpadu bengkel rewinding motor LV/HV 13.8 kV, overhaul turbogenerator &amp; trafo, high speed dynamic balancing tunnel 150 ton ISO 1940, machining bubut vertikal 6.7M, serta toko sparepart motor listrik resmi.
      </p>

      <!-- Apple Action Pill Group -->
      <div class="flex flex-col sm:flex-row flex-wrap items-center justify-center gap-3 sm:gap-4 mt-8 sm:mt-9 w-full sm:w-auto">
        <a
          href="/request-quotation/"
          class="w-full sm:w-auto inline-flex items-center justify-center px-6 sm:px-7 py-3.5 rounded-full bg-white text-slate-950 hover:bg-slate-100 font-semibold text-xs sm:text-sm tracking-tight transition-all shadow-[0_4px_24px_rgba(255,255,255,0.25)] hover:scale-102 active:scale-98"
        >
          <span>Minta Penawaran (RFQ)</span>
        </a>

        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs sm:text-sm tracking-tight transition-all shadow-[0_4px_20px_rgba(5,150,105,0.35)] hover:scale-102 active:scale-98 cursor-pointer"
        >
          <svg class="w-4 h-4 text-white shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
          </svg>
          <span>Chat WhatsApp Langsung</span>
        </a>

        <a
          href="/sparepart/"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-white/[0.12] hover:bg-white/[0.20] text-white border border-white/[0.22] font-semibold text-xs sm:text-sm tracking-tight transition-all backdrop-blur-xl hover:scale-102 active:scale-98"
        >
          <span>Katalog Toko Sparepart</span>
          <span class="text-[10px] font-mono text-sky-300">15 Item &rarr;</span>
        </a>

        <a
          href="/layanan/"
          class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 sm:py-3.5 text-slate-300 hover:text-white text-xs sm:text-sm font-medium transition-colors"
        >
          <span>Eksplorasi Layanan</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

    </div>

    <!-- Apple-style Floating Glass Specs Bento (Mobile 2x2 Grid with Clean Subtle Borders) -->
    <div class="mt-12 sm:mt-20 max-w-5xl mx-auto rounded-3xl bg-slate-950/65 border border-white/[0.12] backdrop-blur-2xl p-4 sm:p-8 shadow-[0_16px_40px_rgba(0,0,0,0.6)]">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-6 text-center">
        <div class="p-3.5 sm:p-4 rounded-2xl bg-white/[0.03] border border-white/[0.06] md:border-none md:bg-transparent">
          <span class="text-xl sm:text-3xl lg:text-4xl font-semibold text-white block tracking-tight">
            30+ Tahun
          </span>
          <span class="text-[11px] sm:text-xs text-slate-400 block mt-1">
            Pengalaman Rekayasa
          </span>
        </div>
        <div class="p-3.5 sm:p-4 rounded-2xl bg-white/[0.03] border border-white/[0.06] md:border-none md:bg-transparent">
          <span class="text-xl sm:text-3xl lg:text-4xl font-semibold text-white block tracking-tight">
            150 Ton
          </span>
          <span class="text-[11px] sm:text-xs text-slate-400 block mt-1">
            Balancing Tunnel
          </span>
        </div>
        <div class="p-3.5 sm:p-4 rounded-2xl bg-white/[0.03] border border-white/[0.06] md:border-none md:bg-transparent">
          <span class="text-xl sm:text-3xl lg:text-4xl font-semibold text-white block tracking-tight">
            13.8 kV
          </span>
          <span class="text-[11px] sm:text-xs text-slate-400 block mt-1">
            Full Voltage Test Bed
          </span>
        </div>
        <div class="p-3.5 sm:p-4 rounded-2xl bg-white/[0.03] border border-white/[0.06] md:border-none md:bg-transparent">
          <span class="text-xl sm:text-3xl lg:text-4xl font-semibold text-white block tracking-tight">
            10 Lokasi
          </span>
          <span class="text-[11px] sm:text-xs text-slate-400 block mt-1">
            Workshop Nasional
          </span>
        </div>
      </div>
    </div>

  </div>
</section>
