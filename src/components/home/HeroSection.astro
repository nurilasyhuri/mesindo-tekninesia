---
import { COMPANY_INFO } from '../../data/companyInfo';
---

<section class="relative py-16 sm:py-24 lg:py-28 flex items-center bg-[#07090e] text-white overflow-hidden font-sans select-none">
  <!-- Cinematic Full Background Canvas -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <img
      src="/images/hero-home-bg.webp"
      alt="Fasilitas Rekayasa Workshop Berat MESINDO TEKNISIA - Stator Rewinding & Balancing Rotor"
      class="w-full h-full object-cover object-center opacity-45 sm:opacity-50"
      loading="eager"
      decoding="async"
    />
    <!-- Deep Vignette & Contrast Control Gradients -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#07090e] via-[#07090e]/55 to-[#07090e]/75"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#07090e]/80 via-transparent to-[#07090e]/80"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 pt-24 sm:pt-32 pb-16 sm:pb-24">
    <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
      
      <!-- Industrial Eyebrow (No pill badge) -->
      <div class="inline-flex items-center gap-2 mb-6 text-[11px] sm:text-xs font-mono font-medium uppercase tracking-[0.2em] text-slate-300">
        <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
        <span>{COMPANY_INFO.name} • EST. {COMPANY_INFO.establishedYear} • ENGINEERING &amp; OVERHAUL</span>
      </div>

      <!-- Apple Keynote Headline with Primary SEO Intent -->
      <h1 class="text-3xl sm:text-5xl lg:text-7xl font-semibold tracking-tight text-white leading-[1.12] sm:leading-[1.08] text-balance drop-shadow-md">
        Overhaul &amp; Rewinding Motor Listrik, Generator &amp; Balancing Industri.
      </h1>

      <!-- Apple Subheadline with Rich Industrial Keywords -->
      <p class="text-sm sm:text-lg lg:text-xl text-slate-300 font-normal leading-relaxed mt-5 sm:mt-6 max-w-3xl text-balance drop-shadow-sm">
        Layanan terpadu bengkel rewinding motor LV/HV 13.8 kV, overhaul turbogenerator &amp; trafo, high speed dynamic balancing tunnel 150 ton ISO 1940, machining bubut vertikal 6.7M, serta toko sparepart motor listrik resmi.
      </p>

      <!-- Action Group -->
      <div class="flex flex-col sm:flex-row flex-wrap items-center justify-center gap-3 sm:gap-4 mt-8 sm:mt-9 w-full sm:w-auto">
        <a
          href="/sparepart/"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-white/[0.12] hover:bg-white/[0.20] text-white border border-white/[0.22] font-semibold text-xs sm:text-sm tracking-tight transition-all backdrop-blur-xl"
        >
          <span>Katalog Toko Sparepart</span>
          <span class="text-[10px] font-mono text-sky-300">15 Item &rarr;</span>
        </a>

        <a
          href="/layanan/"
          class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 sm:py-3.5 text-slate-300 hover:text-white text-xs sm:text-sm font-medium transition-colors"
        >
          <span>Eksplorasi Layanan</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

    </div>

    <!-- Architectural Telemetry Bar (Zero Card Soup: Pure Precision Divider Grid) -->
    <div class="mt-16 sm:mt-24 max-w-6xl mx-auto border-t border-white/[0.12] pt-8 sm:pt-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8 divide-y sm:divide-y-0 sm:divide-x divide-white/[0.1]">
        <div class="text-center sm:text-left sm:px-6 first:pl-0">
          <span class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-white block tracking-tight">
            30+ Tahun
          </span>
          <span class="text-[10px] sm:text-[11px] font-mono uppercase tracking-wider text-slate-400 block mt-1.5">
            Pengalaman Rekayasa Sejak 1994
          </span>
        </div>
        <div class="pt-6 sm:pt-0 text-center sm:text-left sm:px-6">
          <span class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-white block tracking-tight">
            150 Ton
          </span>
          <span class="text-[10px] sm:text-[11px] font-mono uppercase tracking-wider text-slate-400 block mt-1.5">
            Dynamic Balancing Tunnel
          </span>
        </div>
        <div class="pt-6 sm:pt-0 text-center sm:text-left sm:px-6">
          <span class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-white block tracking-tight">
            13.8 kV
          </span>
          <span class="text-[10px] sm:text-[11px] font-mono uppercase tracking-wider text-slate-400 block mt-1.5">
            Full Voltage Test Bed
          </span>
        </div>
        <div class="pt-6 sm:pt-0 text-center sm:text-left sm:px-6">
          <span class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-white block tracking-tight">
            10 Lokasi
          </span>
          <span class="text-[10px] sm:text-[11px] font-mono uppercase tracking-wider text-slate-400 block mt-1.5">
            Jaringan Workshop Nasional
          </span>
        </div>
      </div>
    </div>

  </div>
</section>
