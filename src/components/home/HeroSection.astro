---
import { COMPANY_INFO } from '../../data/companyInfo';
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';

const waHeroUrl = generateGeneralInquiryUrl('hero-section');
---

<section class="relative bg-industrial-950 text-white overflow-hidden font-sans border-b border-industrial-800 min-h-[calc(100vh-112px)] flex flex-col justify-center">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero-industrial.webp"
      alt="Heavy Industrial Engineering Facility PT Mesindo Tekninesia"
      class="w-full h-full object-cover object-[75%_center] sm:object-center opacity-45 lg:opacity-55"
      loading="eager"
      decoding="async"
    />
    <!-- Subtle gradient overlay: deep on the left for text contrast, open on the right for the crane hook & warm lights -->
    <div class="absolute inset-0 bg-gradient-to-r from-industrial-950 via-industrial-950/80 to-industrial-950/30"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-industrial-950 via-transparent to-industrial-950/40"></div>
    <div class="absolute inset-0 bg-[radial-gradient(#0284c7_1px,transparent_1px)] [background-size:24px_24px] opacity-10"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-16 sm:py-24 lg:py-28">
    <div class="max-w-3xl">
      
      <!-- Trust Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-500/10 border border-brand-500/30 text-brand-300 text-xs font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-brand-400 animate-pulse"></span>
        <span>PT Mesindo Tekninesia &bull; Berpengalaman Sejak 1994</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-tight uppercase">
        Repair, Rewinding &amp; <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-400 to-cyan-200">Engineering</span> Equipment Industri.
      </h1>

      <!-- Grounded Subtitle -->
      <p class="text-sm sm:text-base lg:text-lg text-slate-300 font-normal leading-relaxed mt-5 max-w-2xl">
        Mitra rekayasa teknik terpercaya untuk Electro Motor, Generator, Transformer, High Speed Balancing hingga 150 ton, dan Machining komponen ekstra besar dengan standar IEEE, IEC &amp; EASA.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-3 sm:gap-4 mt-8">
        <a
          href="/layanan/"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-brand-600 hover:bg-brand-500 text-white font-bold text-xs sm:text-sm uppercase tracking-wider shadow-lg shadow-brand-900/30 transition-all select-none"
        >
          <span>Katalog Layanan (Koleksi)</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <button
          type="button"
          onclick="window.openRfqDrawer ? window.openRfqDrawer() : null"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-industrial-900/90 hover:bg-industrial-800 text-slate-200 border border-industrial-700 hover:border-slate-500 font-semibold text-xs sm:text-sm transition-all select-none cursor-pointer"
        >
          <svg class="w-4 h-4 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span>Buka Keranjang RFQ</span>
          <span class="rfq-cart-count hidden px-1.5 py-0.5 rounded-full bg-brand-600 text-white text-[10px] font-mono font-bold leading-none">0</span>
        </button>

        <a
          href={waHeroUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-4 py-3.5 rounded-full text-slate-400 hover:text-white text-xs font-semibold transition-colors"
        >
          <span>Konsultasi Hotline &rarr;</span>
        </a>
      </div>

      <!-- Quick Collection Jump Tags (Shopify Hero Feature) -->
      <div class="mt-8 flex flex-wrap items-center gap-2 text-xs">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mr-1">Koleksi Cepat:</span>
        <a href="/layanan/electro-motor/" class="px-3 py-1.5 rounded-full bg-industrial-900/70 hover:bg-brand-600 text-slate-300 hover:text-white border border-industrial-800 hover:border-transparent transition-colors text-[11px] font-medium">
          ⚡ Electro Motor
        </a>
        <a href="/layanan/high-speed-balancing/" class="px-3 py-1.5 rounded-full bg-industrial-900/70 hover:bg-brand-600 text-slate-300 hover:text-white border border-industrial-800 hover:border-transparent transition-colors text-[11px] font-medium">
          🔄 Dynamic Balancing 150T
        </a>
        <a href="/layanan/industrial-machining/" class="px-3 py-1.5 rounded-full bg-industrial-900/70 hover:bg-brand-600 text-slate-300 hover:text-white border border-industrial-800 hover:border-transparent transition-colors text-[11px] font-medium">
          ⚙️ Vertical Lathe 6.7m
        </a>
        <a href="/layanan/generator/" class="px-3 py-1.5 rounded-full bg-industrial-900/70 hover:bg-brand-600 text-slate-300 hover:text-white border border-industrial-800 hover:border-transparent transition-colors text-[11px] font-medium">
          ⚡ Generator Stator
        </a>
        <a href="/layanan/transformer/" class="px-3 py-1.5 rounded-full bg-industrial-900/70 hover:bg-brand-600 text-slate-300 hover:text-white border border-industrial-800 hover:border-transparent transition-colors text-[11px] font-medium">
          🔋 Trafo &amp; Oil Purify
        </a>
      </div>

      <!-- Quick Metrics Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 mt-12 pt-8 border-t border-industrial-800/80">
        {COMPANY_INFO.stats.map((stat) => (
          <div class="p-3.5 rounded-xl bg-industrial-900/60 border border-industrial-800 backdrop-blur-xs">
            <span class="text-xl sm:text-2xl font-extrabold text-white block font-mono">
              {stat.value}
            </span>
            <span class="text-[11px] text-slate-400 block mt-0.5 leading-snug">
              {stat.label}
            </span>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
