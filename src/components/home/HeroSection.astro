---
import { COMPANY_INFO } from '../../data/companyInfo';
---

<section class="relative min-h-[92vh] flex items-center bg-[#07090e] text-white overflow-hidden font-sans select-none">
  <!-- Cinematic Full Background Canvas -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <img
      src="/images/hero-home-bg.webp"
      alt="Fasilitas Rekayasa Workshop Berat MESINDO TEKNISIA - Stator Rewinding & Balancing Rotor"
      class="w-full h-full object-cover object-center opacity-45 sm:opacity-50"
      loading="eager"
      decoding="async"
    />
    <!-- Deep Vignette & Contrast Control Gradients -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#07090e] via-[#07090e]/55 to-[#07090e]/75"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#07090e]/80 via-transparent to-[#07090e]/80"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 pt-24 sm:pt-32 pb-16 sm:pb-24">
    <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
      
      <!-- Apple Eyebrow Kicker with Pill Glow -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/[0.08] border border-white/[0.15] backdrop-blur-md mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-[11px] sm:text-xs font-semibold uppercase tracking-[0.18em] text-slate-200">
          {COMPANY_INFO.name} • Sejak {COMPANY_INFO.establishedYear} • Total Services
        </span>
      </div>

      <!-- Apple Keynote Headline with Primary SEO Intent -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-semibold tracking-tight text-white leading-[1.08] text-balance drop-shadow-md">
        Overhaul &amp; Rewinding Motor Listrik, Generator &amp; Balancing Industri.
      </h1>

      <!-- Apple Subheadline with Rich Industrial Keywords -->
      <p class="text-base sm:text-xl text-slate-300 font-normal leading-relaxed mt-6 max-w-3xl text-balance drop-shadow-sm">
        Layanan terpadu bengkel rewinding motor LV/HV 13.8 kV, overhaul turbogenerator &amp; trafo, high speed dynamic balancing tunnel 150 ton ISO 1940, machining bubut vertikal 6.7M, serta toko sparepart motor listrik resmi.
      </p>

      <!-- Apple Action Pill Group -->
      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 mt-9">
        <a
          href="/request-quotation/"
          class="inline-flex items-center justify-center px-6 sm:px-7 py-3.5 rounded-full bg-white text-slate-950 hover:bg-slate-100 font-semibold text-xs sm:text-sm tracking-tight transition-all shadow-[0_4px_24px_rgba(255,255,255,0.25)] hover:scale-102 active:scale-98"
        >
          <span>Minta Penawaran (RFQ)</span>
        </a>

        <a
          href="/sparepart/"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-white/[0.12] hover:bg-white/[0.20] text-white border border-white/[0.22] font-semibold text-xs sm:text-sm tracking-tight transition-all backdrop-blur-xl hover:scale-102 active:scale-98"
        >
          <span>Katalog Toko Sparepart</span>
          <span class="text-[10px] font-mono text-sky-300">15 Item &rarr;</span>
        </a>

        <a
          href="/layanan/"
          class="inline-flex items-center justify-center gap-1.5 px-4 py-3.5 text-slate-300 hover:text-white text-xs sm:text-sm font-medium transition-colors"
        >
          <span>Eksplorasi Layanan</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

    </div>

    <!-- Apple-style Floating Glass Specs Bento -->
    <div class="mt-16 sm:mt-20 max-w-5xl mx-auto rounded-3xl bg-slate-950/65 border border-white/[0.12] backdrop-blur-2xl p-6 sm:p-8 shadow-[0_16px_40px_rgba(0,0,0,0.6)]">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center divide-y md:divide-y-0 md:divide-x divide-white/[0.08]">
        <div class="pt-4 md:pt-0">
          <span class="text-2xl sm:text-3xl lg:text-4xl font-semibold text-white block tracking-tight">
            30+ Tahun
          </span>
          <span class="text-xs text-slate-400 block mt-1">
            Pengalaman Rekayasa Teknik
          </span>
        </div>
        <div class="pt-4 md:pt-0">
          <span class="text-2xl sm:text-3xl lg:text-4xl font-semibold text-white block tracking-tight">
            150 Ton
          </span>
          <span class="text-xs text-slate-400 block mt-1">
            High Speed Balancing Tunnel
          </span>
        </div>
        <div class="pt-4 md:pt-0">
          <span class="text-2xl sm:text-3xl lg:text-4xl font-semibold text-white block tracking-tight">
            13.8 kV
          </span>
          <span class="text-xs text-slate-400 block mt-1">
            Full Load Voltage Test Bed
          </span>
        </div>
        <div class="pt-4 md:pt-0">
          <span class="text-2xl sm:text-3xl lg:text-4xl font-semibold text-white block tracking-tight">
            10 Lokasi
          </span>
          <span class="text-xs text-slate-400 block mt-1">
            Jaringan Workshop Nasional
          </span>
        </div>
      </div>
    </div>

  </div>
</section>
