---
import { COMPANY_INFO } from '../../data/companyInfo';
---

<section class="py-20 sm:py-28 bg-white font-sans select-none">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Apple Style) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div class="max-w-2xl">
        <span class="text-xs font-semibold uppercase tracking-[0.15em] text-sky-600 block mb-2">
          Jaringan Bengkel &amp; Workshop Mesin Nasional
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-950 tracking-tight leading-tight">
          10 Lokasi Workshop Rekayasa di Seluruh Indonesia.
        </h2>
        <p class="text-sm sm:text-base text-slate-500 mt-3 leading-relaxed">
          Mendukung respon darurat perbaikan 24/7 dan jasa rekayasa on-site di 10 koridor industri utama: Jakarta Utara, Jakarta Timur, Bekasi, Purwakarta, Demak, Sidoarjo, Pekanbaru, Sumatera Selatan, Makassar, dan Timika Papua.
        </p>
      </div>

      <a
        href="/lokasi-workshop/"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-900 hover:bg-black text-white text-xs font-medium tracking-tight transition-all shrink-0"
      >
        <span>Detail 10 Lokasi</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <!-- National Corridor Directory Table (Kurangi Card: 10 Cards Replaced with High-Density Enterprise Directory) -->
    <div class="border-t border-b border-slate-200 divide-y divide-slate-200 bg-white">
      {COMPANY_INFO.workshops.map((w, idx) => (
        <div class="py-5 sm:py-6 px-4 sm:px-6 flex flex-col lg:flex-row lg:items-center justify-between gap-4 sm:gap-6 hover:bg-slate-50/70 transition-colors group">
          
          <!-- Column 1: Identity & Region -->
          <div class="lg:w-1/3 min-w-0">
            <div class="flex items-center gap-2 mb-1.5">
              <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-slate-400">
                LOC-{String(idx + 1).padStart(2, '0')}
              </span>
              <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.2 bg-slate-100 text-slate-700">
                {w.region}
              </span>
              {w.isMainOffice && (
                <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.2 bg-slate-950 text-white font-semibold">
                  Headquarters
                </span>
              )}
            </div>

            <h3 class="text-base font-semibold text-slate-950 group-hover:text-sky-700 transition-colors tracking-tight">
              <a href={`/lokasi-workshop/#${w.id}`}>
                {w.name}
              </a>
            </h3>

            <p class="text-xs text-slate-500 mt-1 leading-relaxed">
              {w.address} {w.area ? `• Luas Area: ${w.area}` : ''}
            </p>
          </div>

          <!-- Column 2: Engineering Capabilities -->
          <div class="lg:w-1/2 min-w-0">
            <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400 block mb-1.5">
              Fasilitas &amp; Ruang Lingkup Layanan:
            </span>
            <div class="flex flex-wrap gap-1.5">
              {w.capabilities.map((cap) => (
                <span class="text-[11px] font-mono px-2 py-0.5 bg-slate-50 border border-slate-200/80 text-slate-700">
                  {cap}
                </span>
              ))}
            </div>
          </div>

          <!-- Column 3: Quick Action -->
          <div class="lg:w-auto shrink-0 flex items-center lg:justify-end pt-2 lg:pt-0">
            <a
              href={`/lokasi-workshop/#${w.id}`}
              class="text-xs font-semibold text-slate-800 group-hover:text-black inline-flex items-center gap-1.5 hover:underline underline-offset-4 transition-all"
            >
              <span>Detail Workshop</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
