---
import { COMPANY_INFO } from '../../data/companyInfo';
---

<section class="py-20 sm:py-28 bg-white font-sans select-none">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Apple Style) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div class="max-w-2xl">
        <span class="text-xs font-semibold uppercase tracking-[0.15em] text-sky-600 block mb-2">
          Jaringan Bengkel &amp; Workshop Mesin Nasional
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-950 tracking-tight leading-tight">
          10 Lokasi Workshop Rekayasa di Seluruh Indonesia.
        </h2>
        <p class="text-sm sm:text-base text-slate-500 mt-3 leading-relaxed">
          Mendukung respon darurat perbaikan 24/7 dan jasa rekayasa on-site di 10 koridor industri utama: Jakarta Utara, Jakarta Timur, Bekasi, Purwakarta, Demak, Sidoarjo, Pekanbaru, Sumatera Selatan, Makassar, dan Timika Papua.
        </p>
      </div>

      <a
        href="/lokasi-workshop/"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-900 hover:bg-black text-white text-xs font-medium tracking-tight transition-all shrink-0"
      >
        <span>Detail 10 Lokasi</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <!-- 10 Workshops Grid in Apple Bento Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {COMPANY_INFO.workshops.map((w) => (
        <div class="p-5 sm:p-8 rounded-2xl bg-[#fbfbfd] border border-slate-200/70 hover:border-slate-300 hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="text-[10px] font-medium uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-slate-200/60 text-slate-700">
                {w.region}
              </span>
              {w.isMainOffice && (
                <span class="text-[10px] font-medium uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-sky-50 text-sky-700 border border-sky-200/60">
                  Headquarters
                </span>
              )}
            </div>

            <h3 class="text-lg font-semibold text-slate-950 leading-snug tracking-tight group-hover:text-sky-600 transition-colors">
              {w.name}
            </h3>

            <p class="text-xs sm:text-sm text-slate-500 mt-2 leading-relaxed">
              {w.address}
            </p>

            <div class="mt-5 pt-4 border-t border-slate-200/60">
              <span class="text-[10px] font-medium uppercase tracking-wider text-slate-400 block mb-2">Kapabilitas:</span>
              <div class="flex flex-wrap gap-1.5">
                {w.capabilities.map((cap) => (
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] bg-white border border-slate-200 text-slate-600 font-medium">
                    {cap}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-200/60">
            <a
              href={`/lokasi-workshop/#${w.id}`}
              class="text-xs font-medium text-slate-600 hover:text-black inline-flex items-center gap-1 transition-colors"
            >
              <span>Alamat &amp; Kontak Cabang</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
