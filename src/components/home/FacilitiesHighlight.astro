---
import { getCollection } from 'astro:content';

const facilities = await getCollection('fasilitas');
facilities.sort((a, b) => a.data.orderPriority - b.data.orderPriority);
---

<section class="py-16 sm:py-24 bg-white font-sans border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <span class="text-xs font-bold text-brand-700 uppercase tracking-wider block mb-1">
        Workshop &amp; Engineering Facilities
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
        Fasilitas Presisi untuk Menangani Equipment Berkapasitas Ekstra Besar
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 mt-2.5 leading-relaxed">
        Keandalan pekerjaan engineering tidak hanya bertumpu pada kompetensi tenaga ahli, tetapi juga ketersediaan mesin balancing, bubut raksasa, dan uji NDT bersertifikasi internasional.
      </p>
    </div>

    <!-- Facility Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {facilities.slice(0, 3).map((item) => (
        <div class="p-6 sm:p-7 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-slate-300 hover:shadow-md transition-all flex flex-col justify-between">
          <div>
            <div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-brand-100 text-brand-800 text-[10px] font-bold uppercase tracking-wider mb-4">
              {item.data.category}
            </div>

            <h3 class="text-lg font-bold text-slate-900 leading-snug">
              {item.data.title}
            </h3>

            <div class="my-3 py-2 px-3 rounded-lg bg-white border border-slate-200 text-xs font-mono font-bold text-brand-700">
              Kapasitas: {item.data.capacity}
            </div>

            <p class="text-xs text-slate-600 leading-relaxed">
              {item.data.description}
            </p>

            {item.data.specs && (
              <div class="mt-4 pt-4 border-t border-slate-200/60 space-y-1 text-[11px] text-slate-500">
                {Object.entries(item.data.specs).slice(0, 3).map(([k, v]) => (
                  <div class="flex justify-between items-center py-0.5">
                    <span class="text-slate-400">{k}:</span>
                    <span class="font-semibold text-slate-800 text-right">{v}</span>
                  </div>
                ))}
              </div>
            )}
          </div>

          <div class="pt-5 mt-4 border-t border-slate-200">
            <a
              href="/fasilitas/"
              class="text-xs font-bold text-brand-700 hover:text-brand-800 inline-flex items-center gap-1 group"
            >
              <span>Pelajari Detail Fasilitas</span>
              <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Banner to full facility page -->
    <div class="mt-10 p-5 rounded-2xl bg-industrial-950 text-white flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-center sm:text-left">
        <h4 class="font-bold text-sm text-white">Butuh informasi kapasitas mesin bubut atau balancing spesifik?</h4>
        <p class="text-xs text-slate-400 mt-0.5">Lihat daftar lengkap mesin bubut horisontal/vertikal, VPI tank, dan test bench kami.</p>
      </div>
      <a
        href="/fasilitas/"
        class="px-5 py-2.5 rounded-full bg-brand-600 hover:bg-brand-500 text-white font-bold text-xs uppercase tracking-wider shrink-0 transition-colors"
      >
        <span>Lihat Semua Fasilitas Mesin &rarr;</span>
      </a>
    </div>

  </div>
</section>
