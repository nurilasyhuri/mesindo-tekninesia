---
import { getCollection } from 'astro:content';

const facilities = await getCollection('fasilitas');
facilities.sort((a, b) => a.data.orderPriority - b.data.orderPriority);
---

<section class="py-20 sm:py-28 bg-white font-sans select-none">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Apple Style) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div class="max-w-2xl">
        <span class="text-xs font-semibold uppercase tracking-[0.15em] text-sky-600 block mb-2">
          Infrastruktur Workshop Permesinan Berat
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-950 tracking-tight leading-tight">
          Fasilitas High Speed Balancing &amp; Bubut Vertikal 6.7M.
        </h2>
        <p class="text-sm sm:text-base text-slate-500 mt-3 leading-relaxed">
          Kapasitas tooling terlengkap di Indonesia: terowongan balancing dinamis rotor 150 ton, mesin bubut vertikal diameter 6.7 meter, bubut horizontal 15 meter, tangki VPI epoksi, dan test bench elektrik 13.8kV.
        </p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <a
          href="/fasilitas/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-900 hover:bg-black text-white text-xs font-medium tracking-tight transition-all"
        >
          <span>Semua Fasilitas Mesin</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Facility Cards Grid (Apple Bento Cards) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {facilities.slice(0, 3).map((item) => (
        <div class="p-8 rounded-2xl bg-[#fbfbfd] border border-slate-200/70 hover:border-slate-300 hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between text-xs text-slate-400 mb-4">
              <span class="font-medium text-slate-500 uppercase tracking-wider text-[10px]">{item.data.category}</span>
              <span class="px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-900 font-mono text-[11px] font-semibold">
                Kapasitas: {item.data.capacity}
              </span>
            </div>

            <h3 class="text-xl font-semibold text-slate-950 leading-snug tracking-tight group-hover:text-sky-600 transition-colors">
              {item.data.title}
            </h3>

            <p class="text-xs sm:text-sm text-slate-500 mt-3 leading-relaxed">
              {item.data.description}
            </p>

            {item.data.specs && (
              <div class="mt-6 pt-5 border-t border-slate-200/60 space-y-2 text-xs">
                {Object.entries(item.data.specs).slice(0, 3).map(([k, v]) => (
                  <div class="flex justify-between items-center py-0.5">
                    <span class="text-slate-400">{k}:</span>
                    <span class="font-medium text-slate-800 text-right font-mono">{v}</span>
                  </div>
                ))}
              </div>
            )}
          </div>

          <div class="pt-6 mt-6 border-t border-slate-200/60">
            <a
              href="/fasilitas/"
              class="text-xs font-medium text-slate-700 hover:text-black inline-flex items-center gap-1 transition-colors"
            >
              <span>Spesifikasi Lengkap &amp; Sertifikat Uji</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
