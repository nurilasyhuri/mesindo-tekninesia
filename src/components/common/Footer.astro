---
import { COMPANY_INFO } from '../../data/companyInfo';
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#111112] text-slate-400 font-sans text-xs select-none">
  
  <!-- Top Standards & Trust Ribbon (Apple Minimalist Integration) -->
  <div class="py-8 px-4 sm:px-6 lg:px-8 bg-white/[0.02]">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3 text-center md:text-left">
        <div class="w-9 h-9 rounded-xl bg-white/[0.06] border border-white/[0.08] text-slate-300 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div>
          <h4 class="text-white font-medium text-xs sm:text-sm tracking-tight">Standar Rekayasa Teknik &amp; Uji Internasional</h4>
          <p class="text-[11px] text-slate-500">Pekerjaan workshop dan penanganan on-site mengacu pada standar global</p>
        </div>
      </div>

      <!-- Standards Badges -->
      <div class="flex flex-wrap items-center justify-center gap-2">
        {COMPANY_INFO.standards.map((st) => (
          <span class="px-2.5 py-1 rounded-full bg-white/[0.04] border border-white/[0.08] text-slate-300 text-[10px] font-mono" title={st.desc}>
            {st.name}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- Main Footer Content (Apple 4 Columns Directory) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      
      <!-- Column 1: Company Profile -->
      <div class="space-y-4">
        <div class="flex flex-col">
          <span class="text-base font-semibold tracking-tight text-white uppercase leading-none">
            MESINDO TEKNISIA
          </span>
          <span class="text-[9px] font-medium tracking-[0.15em] text-slate-500 uppercase leading-none mt-1">
            TOTAL ENGINEERING SERVICES
          </span>
        </div>
        
        <p class="text-xs text-slate-400 leading-relaxed">
          {COMPANY_INFO.name} beroperasi sejak 1994 menyediakan layanan total services perbaikan, rewinding, overhaul, balancing, testing, machining, serta pengadaan komponen industri di seluruh Indonesia.
        </p>

        <!-- Plain Contact Info per preferences.md invariant -->
        <div class="space-y-2 pt-3 border-t border-white/[0.06] text-xs">
          <p class="flex items-start gap-2">
            <span class="text-slate-500 shrink-0">Kantor:</span>
            <span class="text-slate-300">{COMPANY_INFO.workshops[0].address}</span>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-slate-500 shrink-0">Telepon:</span>
            <a href="tel:+6285183002070" class="text-slate-300 hover:text-white transition-colors font-mono">
              {COMPANY_INFO.contact.phoneFormatted}
            </a>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-slate-500 shrink-0">Hotline:</span>
            <span class="text-slate-300 font-mono">
              {COMPANY_INFO.contact.mobileFormatted}
            </span>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-slate-500 shrink-0">Email:</span>
            <span class="text-slate-300 font-mono">{COMPANY_INFO.contact.email}</span>
          </p>
        </div>
      </div>

      <!-- Column 2: Layanan Electrical -->
      <div class="space-y-3">
        <h5 class="text-xs font-semibold text-white tracking-tight">Layanan Electrical &amp; Winding</h5>
        <ul class="space-y-2 text-xs text-slate-400">
          <li>
            <a href="/layanan/electro-motor/" class="hover:text-white transition-colors">
              Electro Motor (LV/HV/DC)
            </a>
          </li>
          <li>
            <a href="/layanan/generator/" class="hover:text-white transition-colors">
              Generator Stator &amp; Rotor Rewind
            </a>
          </li>
          <li>
            <a href="/layanan/transformer/" class="hover:text-white transition-colors">
              Power &amp; Distribution Transformer
            </a>
          </li>
          <li>
            <a href="/layanan/transformer/#purifikasi" class="hover:text-white transition-colors">
              Transformer Oil Purification
            </a>
          </li>
          <li>
            <a href="/layanan/coil-manufacturing/" class="hover:text-white transition-colors">
              Form-Wound Coils &amp; Slip Ring
            </a>
          </li>
          <li>
            <a href="/layanan/testing-assessment/" class="hover:text-white transition-colors">
              Condition Assessment (EL CID / PD)
            </a>
          </li>
          <li>
            <a href="/sparepart/" class="text-sky-400 hover:text-sky-300 font-medium transition-colors">
              Katalog Sparepart Motor Listrik &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Mechanical & Permesinan -->
      <div class="space-y-3">
        <h5 class="text-xs font-semibold text-white tracking-tight">Mechanical &amp; Balancing</h5>
        <ul class="space-y-2 text-xs text-slate-400">
          <li>
            <a href="/layanan/high-speed-balancing/" class="hover:text-white transition-colors">
              High Speed Balancing hingga 150 Ton
            </a>
          </li>
          <li>
            <a href="/layanan/high-speed-balancing/#kapasitas" class="hover:text-white transition-colors">
              Dynamic Balancing 20T, 5T, 0.5T
            </a>
          </li>
          <li>
            <a href="/layanan/industrial-machining/" class="hover:text-white transition-colors">
              Bubut Vertikal Diameter s/d 6.7M
            </a>
          </li>
          <li>
            <a href="/layanan/industrial-machining/#horizontal" class="hover:text-white transition-colors">
              Bubut Horizontal Panjang s/d 15M
            </a>
          </li>
          <li>
            <a href="/layanan/mechanical-services/" class="hover:text-white transition-colors">
              Pump, Compressor &amp; Valve Overhaul
            </a>
          </li>
          <li>
            <a href="/request-quotation/" class="text-sky-400 hover:text-sky-300 font-medium transition-colors">
              Request Quotation (RFQ) Online &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Wilayah Workshop -->
      <div class="space-y-3">
        <h5 class="text-xs font-semibold text-white tracking-tight">{COMPANY_INFO.workshops.length} Workshop Nasional</h5>
        <div class="grid grid-cols-2 gap-2 text-[11px]">
          {COMPANY_INFO.workshops.map((w) => (
            <a
              href={`/lokasi-workshop/#${w.id}`}
              class="p-2 rounded-xl bg-white/[0.04] border border-white/[0.06] hover:bg-white/[0.08] transition-all block"
            >
              <span class="font-medium text-slate-200 block truncate">{w.region}</span>
              <span class="text-slate-500 text-[10px] block truncate">{w.name.replace('Workshop ', '')}</span>
            </a>
          ))}
        </div>
        <div class="pt-2">
          <a
            href="/lokasi-workshop/"
            class="text-sky-400 hover:text-sky-300 text-xs font-medium inline-flex items-center gap-1 transition-colors"
          >
            <span>Alamat &amp; Kontak {COMPANY_INFO.workshops.length} Workshop</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

    </div>
  </div>

  <!-- Bottom Strip (Apple Clean Copyright - with safe padding for MobileStickyBar) -->
  <div class="border-t border-white/[0.06] pt-6 pb-24 md:pb-6 px-4 sm:px-6 lg:px-8 text-center sm:flex sm:justify-between sm:items-center max-w-7xl mx-auto text-slate-500 text-[11px]">
    <p>&copy; {currentYear} {COMPANY_INFO.legalName}. Hak Cipta Dilindungi Undang-Undang.</p>
    <div class="flex items-center justify-center gap-4 mt-2 sm:mt-0">
      <span>Standar Mutu IEEE &bull; IEC &bull; EASA &bull; API &bull; ISO 9001:2015</span>
    </div>
  </div>

</footer>
