---
import { COMPANY_INFO } from '../../data/companyInfo';
import { getCollection } from 'astro:content';
import { SPAREPARTS_CATALOG } from '../../data/spareparts';

export interface Props {
  isHomePage?: boolean;
}

const currentPath = Astro.url.pathname;

const rfqUrl = '/request-quotation/';
const whatsappUrl = `https://wa.me/${COMPANY_INFO.contact.whatsapp}?text=${encodeURIComponent('Halo Tim Engineering MESINDO TEKNISIA, saya ingin konsultasi spesifikasi & penawaran.')}`;

// Pre-load content collections for instant search index
const [allServices, allFacilities, allProjects] = await Promise.all([
  getCollection('layanan'),
  getCollection('fasilitas'),
  getCollection('proyek'),
]);

const searchItems = [
  // Core Services
  ...allServices.map((s) => ({
    title: s.data.title,
    desc: s.data.description,
    url: `/layanan/${s.slug}/`,
    category: 'Layanan',
    badge: s.data.categoryLabel,
    img: s.data.thumbnail,
  })),
  // Facilities
  ...allFacilities.map((f) => ({
    title: f.data.title,
    desc: `${f.data.category} - Kapasitas: ${f.data.capacity}. ${f.data.description}`,
    url: `/fasilitas/`,
    category: 'Fasilitas',
    badge: f.data.category,
    img: f.data.coverImage,
  })),
  // Projects
  ...allProjects.map((p) => ({
    title: p.data.title,
    desc: `${p.data.sector} - ${p.data.equipment} di ${p.data.location}.`,
    url: `/proyek/`,
    category: 'Proyek',
    badge: p.data.sector,
    img: p.data.coverImage,
  })),
  // 10 Workshops
  ...COMPANY_INFO.workshops.map((w) => ({
    title: w.name,
    desc: `${w.address}. Melayani: ${w.capabilities.join(', ')}.`,
    url: `/lokasi-workshop/#${w.id}`,
    category: 'Workshop',
    badge: w.region,
    img: '/images/facility-workshop.webp',
  })),
  // 15 Spareparts
  ...SPAREPARTS_CATALOG.map((item) => ({
    title: item.name,
    desc: `${item.shortDesc} Kata kunci: ${item.keywords.join(', ')}`,
    url: `/layanan/sparepart-motor-listrik/#${item.id}`,
    category: 'Sparepart',
    badge: item.category,
    img: item.image,
  })),
  // RFQ Tool
  {
    title: 'Request Quotation (RFQ) Online',
    desc: 'Formulir permohonan penawaran teknis resmi berbasis spesifikasi nameplate.',
    url: '/request-quotation/',
    category: 'Layanan',
    badge: 'Estimasi RFQ',
    img: '/images/hero-industrial.webp',
  },
];
---

<!-- Top Utility Ribbon (Apple Clean Dark Strip) -->
<!-- Top Utility Ribbon (Screenshot Flagship Style) -->
<div class="bg-[#121417] text-slate-400 text-xs py-1.5 px-4 hidden sm:block font-sans select-none border-b border-white/[0.06]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center text-[11px] tracking-tight">
    <div class="flex items-center gap-2">
      <svg class="w-3.5 h-3.5 text-sky-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
      </svg>
      <span class="font-medium text-slate-200">Official Engineering Workshop</span>
      <span class="text-slate-600">•</span>
      <span class="text-slate-400">Member EASA AR100 &amp; IEEE 1068</span>
    </div>
    
    <div class="hidden md:flex items-center text-slate-300 text-center font-normal">
      <span>Layanan Rekayasa &amp; Overhaul Seluruh Indonesia • Hotline: <strong class="font-mono text-white font-medium">{COMPANY_INFO.contact.phoneFormatted}</strong></span>
    </div>

    <div class="flex items-center gap-2">
      <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
      <span class="text-slate-300">ISO 9001:2015 Terverifikasi</span>
    </div>
  </div>
</div>

<!-- Main Sticky Header -->
<header
  id="main-header"
  class="sticky top-0 z-40 bg-white/95 backdrop-blur-xl border-b border-slate-200/80 font-sans transition-all duration-200 relative"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-14 sm:h-16">
      
      <!-- Left: Simplified Navigation Buttons (Home, Layanan with Mega Menu, Katalog, Kontak) -->
      <div class="flex items-center min-w-0 flex-1">
        <!-- Mobile Menu Toggle Button -->
        <button
          id="menu-btn"
          type="button"
          aria-label="Buka Menu"
          class="lg:hidden p-2 -ml-1 text-slate-700 hover:text-slate-950 hover:bg-slate-100 rounded-lg transition-colors cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <!-- Desktop Navigation Items (Exactly 4 items with spacious gap matching screenshot) -->
        <nav class="hidden lg:flex items-center gap-7 xl:gap-8 text-xs font-semibold uppercase tracking-wider text-slate-700 whitespace-nowrap">
          
          <!-- 1. Home (Plain text link, no box, spacious spacing) -->
          <a
            href="/"
            class:list={[
              'py-2 transition-colors hover:text-slate-950 whitespace-nowrap',
              currentPath === '/' ? 'text-slate-950 font-bold' : 'text-slate-700'
            ]}
          >
            Home
          </a>

          <!-- 2. Layanan (Mega Menu Trigger) -->
          <div class="relative flex items-center" id="mega-menu-wrapper">
            <button
              type="button"
              id="mega-menu-trigger"
              aria-expanded="false"
              aria-controls="mega-menu-panel"
              class:list={[
                'inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-md uppercase tracking-wider transition-all cursor-pointer font-bold whitespace-nowrap',
                currentPath.startsWith('/layanan') && !currentPath.includes('/sparepart')
                  ? 'bg-slate-200/90 text-slate-950 shadow-2xs'
                  : 'bg-slate-100 text-slate-800 hover:bg-slate-200/80 hover:text-slate-950'
              ]}
            >
              <span>Layanan</span>
              <svg
                id="mega-chevron"
                class="w-3.5 h-3.5 text-slate-500 transition-transform duration-200"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </div>

          <!-- 3. Katalog (Mega Menu Trigger - Matches Layanan Style) -->
          <div class="relative flex items-center" id="catalog-mega-wrapper">
            <button
              type="button"
              id="catalog-mega-trigger"
              aria-expanded="false"
              aria-controls="catalog-mega-panel"
              class:list={[
                'inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-md uppercase tracking-wider transition-all cursor-pointer font-bold whitespace-nowrap',
                currentPath.startsWith('/sparepart')
                  ? 'bg-slate-200/90 text-slate-950 shadow-2xs'
                  : 'bg-slate-100 text-slate-800 hover:bg-slate-200/80 hover:text-slate-950'
              ]}
            >
              <span>Katalog</span>
              <svg
                id="catalog-mega-chevron"
                class="w-3.5 h-3.5 text-slate-500 transition-transform duration-200"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </div>

          <!-- 4. Kontak (Plain text link, no box) -->
          <a
            href="/kontak/"
            class:list={[
              'py-2 transition-colors hover:text-slate-950 whitespace-nowrap',
              currentPath.startsWith('/kontak') ? 'text-slate-950 font-bold' : 'text-slate-700'
            ]}
          >
            Kontak
          </a>

        </nav>
      </div>

      <!-- Center: Clean Brand Logo (Responsive on Mobile) -->
      <div class="flex items-center justify-center shrink-0 px-1 sm:px-4">
        <a href="/" class="flex flex-col items-center justify-center group text-center py-1">
          <span class="text-[13px] sm:text-base md:text-lg font-black tracking-[0.08em] sm:tracking-[0.14em] text-slate-950 uppercase group-hover:text-sky-600 transition-colors whitespace-nowrap">
            MESINDO<span class="text-slate-400 font-light mx-0.5 sm:mx-1">•</span>TEKNISIA
          </span>
          <span class="text-[8px] sm:text-[9px] uppercase tracking-[0.18em] sm:tracking-[0.24em] text-slate-400 font-semibold -mt-0.5 whitespace-nowrap">
            Engineering &amp; Overhaul
          </span>
        </a>
      </div>

      <!-- Right: Action Items (Search + RFQ Cart Bag + Pill Button) -->
      <div class="flex items-center justify-end min-w-0 flex-1 gap-2.5 sm:gap-3 shrink-0">
        <!-- Search Trigger Button -->
        <button
          id="search-trigger"
          type="button"
          aria-label="Cari Equipment & Layanan (Ctrl+K)"
          class="inline-flex items-center gap-2 px-2.5 py-1.5 rounded-full bg-slate-100/90 hover:bg-slate-200/90 text-slate-500 hover:text-slate-900 text-xs transition-colors cursor-pointer"
        >
          <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.34-4.34"></path>
          </svg>
          <span class="hidden sm:inline text-[11px] font-normal">Cari...</span>
          <kbd class="hidden sm:inline-block px-1 py-0.2 text-[9px] font-mono font-medium text-slate-400 bg-white/80 rounded">⌘K</kbd>
        </button>

        <!-- Keranjang RFQ Trigger (Screenshot Bag Style with Badge) -->
        <button
          type="button"
          onclick="window.openRfqDrawer ? window.openRfqDrawer() : null"
          aria-label="Buka Keranjang RFQ"
          class="relative p-2 rounded-full text-slate-700 hover:text-black hover:bg-slate-100 transition-colors cursor-pointer"
          title="Keranjang Permintaan Penawaran (RFQ)"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
          </svg>
          <span class="rfq-cart-count absolute -top-0.5 -right-0.5 inline-flex items-center justify-center min-w-[17px] h-[17px] px-1 rounded-full bg-slate-950 text-white text-[9px] font-bold font-mono leading-none hidden shadow-sm">
            0
          </span>
        </button>

        <!-- Primary RFQ Action (Pill Button) -->
        <a
          href={rfqUrl}
          class="hidden sm:inline-flex items-center justify-center px-4 py-1.5 rounded-full bg-slate-900 hover:bg-black text-white text-xs font-semibold tracking-tight transition-all shadow-xs"
        >
          <span>Minta RFQ</span>
        </a>
      </div>

    </div>
  </div>

  <!-- MEGA MENU DROPDOWN PANEL (Exact Layout & Visual Composition from Screenshot) -->
  <div
    id="mega-menu-panel"
    class="hidden absolute top-full inset-x-0 w-full bg-white border-b border-slate-200/90 shadow-2xl transition-all duration-200 z-50 font-sans"
    style="background-color: #ffffff;"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-7 sm:py-8 space-y-7">
      
      <!-- Section 1: KATEGORI KOLEKSI UTAMA (5 Visual Banner Cards) -->
      <div>
        <div class="flex items-center justify-between mb-3.5 pb-2 border-b border-slate-100">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span class="text-xs font-bold uppercase tracking-[0.16em] text-slate-900">
              Kategori Layanan Utama
            </span>
          </div>
          <span class="text-[11px] font-mono text-slate-400">
            {allServices.length} Spesialisasi Rekayasa &amp; Overhaul
          </span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3.5">
          <!-- Card 1: Electro Motor -->
          <a
            href="/layanan/electro-motor/"
            class="group relative aspect-[16/10] rounded-xl overflow-hidden bg-slate-900 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between p-3.5 select-none"
          >
            <img
              src="/images/gallery-rewind-rotor.webp"
              alt="Electro Motor"
              class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 group-hover:opacity-75 transition-all duration-300"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>

            <div class="relative z-10 flex items-start justify-between">
              <span class="px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-white/90 text-slate-900 backdrop-blur-xs">
                LV &amp; HV MOTOR
              </span>
            </div>

            <div class="relative z-10 flex items-end justify-between gap-2 mt-auto">
              <div class="min-w-0">
                <h4 class="text-xs sm:text-sm font-bold text-white tracking-tight truncate group-hover:text-sky-300 transition-colors">
                  Electro Motor
                </h4>
                <p class="text-[10px] text-slate-300 font-normal truncate mt-0.5">
                  Rewind &amp; Overhaul 13.8kV
                </p>
              </div>
              <div class="w-6 h-6 rounded-full bg-white/20 group-hover:bg-white text-white group-hover:text-slate-950 flex items-center justify-center shrink-0 transition-colors backdrop-blur-xs">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </div>
            </div>
          </a>

          <!-- Card 2: Generator & Turbin -->
          <a
            href="/layanan/generator/"
            class="group relative aspect-[16/10] rounded-xl overflow-hidden bg-slate-900 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between p-3.5 select-none"
          >
            <img
              src="/images/hero-industrial.webp"
              alt="Generator & Turbin"
              class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 group-hover:opacity-75 transition-all duration-300"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>

            <div class="relative z-10 flex items-start justify-between">
              <span class="px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-white/90 text-slate-900 backdrop-blur-xs">
                PLTU &amp; INDUSTRI
              </span>
            </div>

            <div class="relative z-10 flex items-end justify-between gap-2 mt-auto">
              <div class="min-w-0">
                <h4 class="text-xs sm:text-sm font-bold text-white tracking-tight truncate group-hover:text-sky-300 transition-colors">
                  Generator &amp; Turbin
                </h4>
                <p class="text-[10px] text-slate-300 font-normal truncate mt-0.5">
                  Stator/Rotor Re-insulation
                </p>
              </div>
              <div class="w-6 h-6 rounded-full bg-white/20 group-hover:bg-white text-white group-hover:text-slate-950 flex items-center justify-center shrink-0 transition-colors backdrop-blur-xs">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </div>
            </div>
          </a>

          <!-- Card 3: Dynamic Balancing -->
          <a
            href="/layanan/high-speed-balancing/"
            class="group relative aspect-[16/10] rounded-xl overflow-hidden bg-slate-900 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between p-3.5 select-none"
          >
            <img
              src="/images/service-balancing.webp"
              alt="Dynamic Balancing"
              class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 group-hover:opacity-75 transition-all duration-300"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>

            <div class="relative z-10 flex items-start justify-between">
              <span class="px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-white/90 text-slate-900 backdrop-blur-xs">
                TUNNEL 150 TON
              </span>
            </div>

            <div class="relative z-10 flex items-end justify-between gap-2 mt-auto">
              <div class="min-w-0">
                <h4 class="text-xs sm:text-sm font-bold text-white tracking-tight truncate group-hover:text-sky-300 transition-colors">
                  Dynamic Balancing
                </h4>
                <p class="text-[10px] text-slate-300 font-normal truncate mt-0.5">
                  Vacuum Chamber ISO 1940
                </p>
              </div>
              <div class="w-6 h-6 rounded-full bg-white/20 group-hover:bg-white text-white group-hover:text-slate-950 flex items-center justify-center shrink-0 transition-colors backdrop-blur-xs">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </div>
            </div>
          </a>

          <!-- Card 4: Industrial Machining -->
          <a
            href="/layanan/industrial-machining/"
            class="group relative aspect-[16/10] rounded-xl overflow-hidden bg-slate-900 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between p-3.5 select-none"
          >
            <img
              src="/images/facility-lathe-real.webp"
              alt="Industrial Machining"
              class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 group-hover:opacity-75 transition-all duration-300"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>

            <div class="relative z-10 flex items-start justify-between">
              <span class="px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-white/90 text-slate-900 backdrop-blur-xs">
                BUBUT 6.7M &amp; 15M
              </span>
            </div>

            <div class="relative z-10 flex items-end justify-between gap-2 mt-auto">
              <div class="min-w-0">
                <h4 class="text-xs sm:text-sm font-bold text-white tracking-tight truncate group-hover:text-sky-300 transition-colors">
                  Industrial Machining
                </h4>
                <p class="text-[10px] text-slate-300 font-normal truncate mt-0.5">
                  Vertical &amp; Horizontal Lathe
                </p>
              </div>
              <div class="w-6 h-6 rounded-full bg-white/20 group-hover:bg-white text-white group-hover:text-slate-950 flex items-center justify-center shrink-0 transition-colors backdrop-blur-xs">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </div>
            </div>
          </a>

          <!-- Card 5: Transformer Services -->
          <a
            href="/layanan/transformer/"
            class="group relative aspect-[16/10] rounded-xl overflow-hidden bg-slate-900 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between p-3.5 select-none"
          >
            <img
              src="/images/gallery-transformer-overhaul.webp"
              alt="Transformer Services"
              class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 group-hover:opacity-75 transition-all duration-300"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>

            <div class="relative z-10 flex items-start justify-between">
              <span class="px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-white/90 text-slate-900 backdrop-blur-xs">
                TRAFO &amp; MINYAK
              </span>
            </div>

            <div class="relative z-10 flex items-end justify-between gap-2 mt-auto">
              <div class="min-w-0">
                <h4 class="text-xs sm:text-sm font-bold text-white tracking-tight truncate group-hover:text-sky-300 transition-colors">
                  Transformer Services
                </h4>
                <p class="text-[10px] text-slate-300 font-normal truncate mt-0.5">
                  Purifikasi Oli &amp; OLTC Overhaul
                </p>
              </div>
              <div class="w-6 h-6 rounded-full bg-white/20 group-hover:bg-white text-white group-hover:text-slate-950 flex items-center justify-center shrink-0 transition-colors backdrop-blur-xs">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </div>
            </div>
          </a>
        </div>
      </div>

      <!-- Section 2: SPESIALISASI TAMBAHAN & ASESMEN REKAYASA (4 Horizontal Cards) -->
      <div>
        <div class="flex items-center justify-between mb-3.5 pb-2 border-b border-slate-100">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span class="text-xs font-bold uppercase tracking-[0.16em] text-slate-900">
              Spesialisasi Tambahan &amp; Asesmen Lapangan
            </span>
          </div>
          <span class="text-[11px] font-mono text-slate-400">
            Layanan Rekayasa Berstandar EASA
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
          <!-- Item 1: Coil Manufacturing -->
          <a
            href="/layanan/coil-manufacturing/"
            class="group p-3 rounded-xl bg-slate-50/80 hover:bg-white border border-slate-200/80 hover:border-slate-300 hover:shadow-xs transition-all flex items-center justify-between gap-3 select-none"
          >
            <div class="w-12 h-12 rounded-lg bg-white border border-slate-200/80 p-1 shrink-0 overflow-hidden flex items-center justify-center">
              <img src="/images/gallery-coil-manufacturing.webp" alt="Pabrikasi Coil" class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
            </div>
            <div class="min-w-0 flex-1">
              <span class="text-[10px] font-semibold text-sky-700 block truncate">
                Class H 13.8kV • Form-Wound
              </span>
              <h5 class="text-xs font-bold text-slate-900 tracking-tight truncate group-hover:text-sky-700 transition-colors">
                Pabrikasi Kumparan Coil
