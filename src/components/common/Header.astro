---
import { COMPANY_INFO } from '../../data/companyInfo';
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';
import { getCollection } from 'astro:content';

export interface Props {
  isHomePage?: boolean;
}

const currentPath = Astro.url.pathname;
const { isHomePage = currentPath === '/' || currentPath === '' } = Astro.props;

const waInquiryUrl = generateGeneralInquiryUrl('header-contact');
const rfqUrl = '/request-quotation/';

// Pre-load content collections for instant search index
const [allServices, allFacilities, allProjects] = await Promise.all([
  getCollection('layanan'),
  getCollection('fasilitas'),
  getCollection('proyek'),
]);

const searchItems = [
  // Core Services
  ...allServices.map((s) => ({
    title: s.data.title,
    desc: s.data.description,
    url: `/layanan/${s.slug}/`,
    category: 'Layanan',
    badge: s.data.categoryLabel,
    img: s.data.thumbnail,
  })),
  // Facilities
  ...allFacilities.map((f) => ({
    title: f.data.title,
    desc: `${f.data.category} - Kapasitas: ${f.data.capacity}. ${f.data.description}`,
    url: `/fasilitas/`,
    category: 'Fasilitas',
    badge: f.data.category,
    img: f.data.coverImage,
  })),
  // Projects
  ...allProjects.map((p) => ({
    title: p.data.title,
    desc: `${p.data.sector} - ${p.data.equipment} di ${p.data.location}.`,
    url: `/proyek/`,
    category: 'Proyek',
    badge: p.data.sector,
    img: p.data.coverImage,
  })),
  // 9 Workshops
  ...COMPANY_INFO.workshops.map((w) => ({
    title: w.name,
    desc: `${w.address}. Melayani: ${w.capabilities.join(', ')}.`,
    url: `/lokasi-workshop/#${w.id}`,
    category: 'Workshop',
    badge: w.region,
    img: '/images/facility-workshop.webp',
  })),
  // RFQ Tool
  {
    title: 'Request Quotation (RFQ) Online',
    desc: 'Formulir permohonan penawaran teknis untuk electro motor, generator, transformer, balancing, dan permesinan industri.',
    url: '/request-quotation/',
    category: 'Layanan',
    badge: 'Estimasi RFQ',
    img: '/images/hero-industrial.webp',
  },
];
---

<!-- Top Announcement Strip (Shopify B2B Style) -->
<div
  id="top-announcement-bar"
  class="bg-industrial-950 text-slate-300 text-[11px] font-medium tracking-wide py-2 px-4 border-b border-industrial-800/80 select-none relative z-40"
>
  <div class="max-w-7xl mx-auto sm:px-6 lg:px-8 flex justify-between items-center">
    <!-- Left: Value Proposition & Experience -->
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-1.5 text-brand-400 font-semibold uppercase tracking-wider text-[10px] sm:text-[11px]">
        <svg class="w-3.5 h-3.5 text-brand-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span>PT Mesindo Tekninesia • Est. 1994</span>
      </span>
      <span class="text-slate-700 hidden sm:inline">•</span>
      <span class="hidden md:inline text-slate-400 font-normal">
        Standar Internasional IEEE, IEC, EASA, API, NFPA &amp; VDE
      </span>
    </div>

    <!-- Right: Hotline & 9 Workshops Indicator -->
    <div class="flex items-center gap-3 text-slate-300 font-medium">
      <a
        href="/lokasi-workshop/"
        class="hidden lg:inline-flex items-center gap-1.5 text-slate-400 hover:text-white transition-colors text-[11px]"
      >
        <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>Workshop Nasional</span>
      </a>
      <span class="hidden sm:inline text-slate-700">•</span>
      <a
        href="/kontak/"
        class="inline-flex items-center gap-1.5 text-slate-300 hover:text-white font-medium transition-colors text-[11px]"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-brand-400 animate-pulse"></span>
        <span>Konsultasi &amp; Kontak Resmi</span>
        <svg class="w-3 h-3 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</div>

<!-- Main Sticky Header -->
<header
  id="main-header"
  data-home={isHomePage ? 'true' : 'false'}
  class="sticky top-0 z-40 bg-white/95 backdrop-blur-xl border-b border-slate-200/90 shadow-2xs font-sans transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-[72px] relative">
      
      <!-- Mobile Left: Hamburger Button -->
      <div class="flex items-center lg:hidden z-10">
        <button
          id="menu-btn"
          type="button"
          aria-label="Buka Menu Navigasi"
          class="p-2 -ml-1 rounded-lg text-slate-700 hover:text-slate-900 hover:bg-slate-100 transition-colors cursor-pointer"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Center Logo (Mobile) / Left Logo (Desktop) -->
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 lg:static lg:translate-x-0 lg:translate-y-0 lg:flex items-center shrink-0 z-10 text-center lg:text-left">
        <a href="/" title="PT Mesindo Tekninesia" class="flex flex-col group">
          <span class="text-lg sm:text-xl font-black tracking-tight leading-none text-slate-950 uppercase transition-colors group-hover:text-brand-700">
            MESINDO TEKNINESIA<span class="text-brand-600">.</span>
          </span>
          <span class="text-[8px] sm:text-[9px] font-bold tracking-[0.2em] text-slate-500 uppercase leading-none mt-1">
            REPAIR • BALANCING • ENGINEERING
          </span>
        </a>
      </div>

      <!-- Desktop Navigation Menu (Refined, Editorial Shopify B2B Style with Full Dropdowns) -->
      <nav class="hidden lg:flex items-center gap-4 xl:gap-6 h-full">
        
        <!-- 1. Beranda Dropdown -->
        <div class="relative group h-full flex items-center">
          <a
            href="/"
            class:list={[
              'inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider transition-colors py-2 relative select-none',
              currentPath === '/'
                ? 'text-brand-700 after:absolute after:bottom-0 after:left-0 after:right-0 after:h-0.5 after:bg-brand-600'
                : 'text-slate-700 hover:text-slate-950'
            ]}
          >
            <span>Beranda</span>
            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>

          <div class="absolute left-0 top-[68px] w-[330px] rounded-2xl border border-slate-200 bg-white p-4 shadow-2xl opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
            <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 pb-1.5 border-b border-slate-100 mb-2">
              Navigasi Cepat Beranda
            </div>
            <div class="space-y-1">
              <a href="/#katalog-layanan" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="text-xs font-bold text-slate-900">Katalog Layanan Engineering</span>
                <span class="text-[11px] text-slate-500">Koleksi 8 spesialisasi repair &amp; overhaul</span>
              </a>
              <a href="/#keunggulan" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="text-xs font-bold text-slate-900">Standar Mutu Sejak 1994</span>
                <span class="text-[11px] text-slate-500">IEEE, IEC, EASA &amp; ISO 9001:2015</span>
              </a>
              <a href="/lokasi-workshop/" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="text-xs font-bold text-slate-900">Jaringan 8 Workshop Nasional</span>
                <span class="text-[11px] text-slate-500">Jakarta, Sidoarjo, Purwakarta s/d Timika</span>
              </a>
              <a href="/request-quotation/" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="text-xs font-bold text-slate-900">Permohonan Penawaran (RFQ)</span>
                <span class="text-[11px] text-slate-500">Estimasi berbasis data nameplate</span>
              </a>
            </div>
            <div class="mt-3 pt-2.5 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-400 text-[10px]">PT Mesindo Tekninesia</span>
              <a href="/" class="text-[11px] font-bold text-brand-700 hover:text-brand-800">Ke Beranda Utama &rarr;</a>
            </div>
          </div>
        </div>

        <!-- 2. Layanan (Unified Mega Dropdown) -->
        <div class="relative group h-full flex items-center">
          <a
            href="/layanan/"
            class:list={[
              'inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider transition-colors py-2 relative select-none',
              currentPath.startsWith('/layanan')
                ? 'text-brand-700 after:absolute after:bottom-0 after:left-0 after:right-0 after:h-0.5 after:bg-brand-600'
                : 'text-slate-700 hover:text-slate-950'
            ]}
          >
            <span>Layanan</span>
            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          
          <div class="absolute left-1/2 -translate-x-1/2 top-[68px] w-[540px] rounded-2xl border border-slate-200 bg-white p-5 shadow-2xl opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
            <div class="grid grid-cols-2 gap-6">
              <!-- Col 1: Rotating & Electrical -->
              <div class="space-y-1">
                <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 pb-1.5 border-b border-slate-100 mb-2">
                  Rotating &amp; Electrical
                </div>
                <a href="/layanan/electro-motor/" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                  <span class="text-xs font-bold text-slate-900">Electro Motor</span>
                  <span class="text-[11px] text-slate-500">Repair, LV/HV Rewinding &amp; Overhaul</span>
                </a>
                <a href="/layanan/generator/" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                  <span class="text-xs font-bold text-slate-900">Generator &amp; Turbogenerator</span>
                  <span class="text-[11px] text-slate-500">Stator/Rotor Rewind &amp; Re-insulation</span>
                </a>
                <a href="/layanan/transformer/" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                  <span class="text-xs font-bold text-slate-900">Transformer</span>
                  <span class="text-[11px] text-slate-500">Overhaul, Oil Purification &amp; OLTC</span>
                </a>
                <a href="/layanan/coil-manufacturing/" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                  <span class="text-xs font-bold text-slate-900">Coil Manufacturing</span>
                  <span class="text-[11px] text-slate-500">Formed Coils &amp; Slip Ring Precision</span>
                </a>
              </div>

              <!-- Col 2: Mechanical & Machining -->
              <div class="space-y-1">
                <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 pb-1.5 border-b border-slate-100 mb-2">
                  Mechanical &amp; Testing
                </div>
                <a href="/layanan/high-speed-balancing/" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                  <span class="text-xs font-bold text-slate-900">High Speed Balancing</span>
                  <span class="text-[11px] text-slate-500">Hingga 150 Ton di Kecepatan Operasi</span>
                </a>
                <a href="/layanan/industrial-machining/" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                  <span class="text-xs font-bold text-slate-900">Industrial Machining</span>
                  <span class="text-[11px] text-slate-500">Vertical Lathe 6.7m &amp; Horizontal 15m</span>
                </a>
                <a href="/layanan/mechanical-services/" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                  <span class="text-xs font-bold text-slate-900">Mechanical Services</span>
                  <span class="text-[11px] text-slate-500">Pump, Compressor, Turbocharger &amp; Valve</span>
                </a>
                <a href="/layanan/testing-assessment/" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                  <span class="text-xs font-bold text-slate-900">Testing &amp; Assessment</span>
                  <span class="text-[11px] text-slate-500">EL CID, Partial Discharge &amp; NDT</span>
                </a>
              </div>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-500 text-[11px]">Standar IEEE, IEC, EASA, API &amp; VDE</span>
              <a href="/layanan/" class="font-bold text-brand-700 hover:text-brand-800">Katalog Semua Layanan (8) &rarr;</a>
            </div>
          </div>
        </div>

        <!-- 3. Fasilitas Dropdown -->
        <div class="relative group h-full flex items-center">
          <a
            href="/fasilitas/"
            class:list={[
              'inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider transition-colors py-2 relative select-none',
              currentPath.startsWith('/fasilitas')
                ? 'text-brand-700 after:absolute after:bottom-0 after:left-0 after:right-0 after:h-0.5 after:bg-brand-600'
                : 'text-slate-700 hover:text-slate-950'
            ]}
          >
            <span>Fasilitas</span>
            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>

          <div class="absolute left-1/2 -translate-x-1/2 top-[68px] w-[380px] rounded-2xl border border-slate-200 bg-white p-4 sm:p-5 shadow-2xl opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
            <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 pb-1.5 border-b border-slate-100 mb-2">
              Fasilitas Permesinan &amp; Pengujian
            </div>
            <div class="space-y-1">
              <a href="/layanan/high-speed-balancing/" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-slate-900">High Speed Balancing 150 Ton</span>
                  <span class="text-[9px] font-bold uppercase bg-brand-50 text-brand-700 px-1.5 py-0.5 rounded">150T</span>
                </div>
                <span class="text-[11px] text-slate-500">Terowongan balancing turbin uap &amp; generator</span>
              </a>
              <a href="/layanan/industrial-machining/" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-slate-900">Vertical Lathe 6.7m x 8m</span>
                  <span class="text-[9px] font-bold uppercase bg-slate-100 text-slate-700 px-1.5 py-0.5 rounded">6.7m</span>
                </div>
                <span class="text-[11px] text-slate-500">Bubut vertikal ekstra besar diameter 6.7 meter</span>
              </a>
              <a href="/fasilitas/" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="text-xs font-bold text-slate-900">Horizontal Lathe Panjang 15 Meter</span>
                <span class="text-[11px] text-slate-500">Pemesinan poros turbin, shaft, dan roll industri</span>
              </a>
              <a href="/fasilitas/" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="text-xs font-bold text-slate-900">VPI Impregnation Chamber Class H</span>
                <span class="text-[11px] text-slate-500">Tangki vakum resin insulasi tahan suhu 200°C</span>
              </a>
              <a href="/layanan/testing-assessment/" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="text-xs font-bold text-slate-900">Electrical Test Bench &amp; NDT 15kV</span>
                <span class="text-[11px] text-slate-500">Uji beban, EL CID, partial discharge &amp; vibration</span>
              </a>
            </div>
            <div class="mt-3 pt-2.5 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-400 text-[10px]">Kapasitas Crane s/d 50 Ton</span>
              <a href="/fasilitas/" class="text-[11px] font-bold text-brand-700 hover:text-brand-800">Katalog Semua Fasilitas &rarr;</a>
            </div>
          </div>
        </div>

        <!-- 4. Workshop Dropdown -->
        <div class="relative group h-full flex items-center">
          <a
            href="/lokasi-workshop/"
            class:list={[
              'inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider transition-colors py-2 relative select-none',
              currentPath.startsWith('/lokasi-workshop')
                ? 'text-brand-700 after:absolute after:bottom-0 after:left-0 after:right-0 after:h-0.5 after:bg-brand-600'
                : 'text-slate-700 hover:text-slate-950'
            ]}
          >
            <span>Workshop</span>
            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>

          <div class="absolute left-1/2 -translate-x-1/2 top-[68px] w-[400px] rounded-2xl border border-slate-200 bg-white p-4 sm:p-5 shadow-2xl opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
            <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 pb-1.5 border-b border-slate-100 mb-2">
              8 Jaringan Workshop Nasional
            </div>
            <div class="grid grid-cols-2 gap-1">
              <a href="/lokasi-workshop/#workshop-jakarta-utara" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="text-xs font-bold text-slate-900">Jakarta Utara (HQ)</span>
                <span class="text-[10px] text-brand-700 font-semibold">Area 25.000 M² &bull; Hub Utama</span>
              </a>
              <a href="/lokasi-workshop/#workshop-makassar" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="text-xs font-bold text-slate-900">Makassar (Sulawesi)</span>
                <span class="text-[10px] text-slate-500">Area 5.000 M² &bull; Hub Timur</span>
              </a>
              <a href="/lokasi-workshop/#workshop-purwakarta" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="text-xs font-bold text-slate-900">Purwakarta (Jabar)</span>
                <span class="text-[10px] text-slate-500">Area 3.000 M² &bull; Koridor Kimia</span>
              </a>
              <a href="/lokasi-workshop/#workshop-sidoarjo" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="text-xs font-bold text-slate-900">Sidoarjo (Jatim)</span>
                <span class="text-[10px] text-slate-500">Sentra Motor &amp; Machining</span>
              </a>
              <a href="/lokasi-workshop/#workshop-jakarta-timur" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="text-xs font-bold text-slate-900">Jakarta Timur</span>
                <span class="text-[10px] text-slate-500">Repair Motor &amp; Generator</span>
              </a>
              <a href="/lokasi-workshop/#workshop-demak" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="text-xs font-bold text-slate-900">Demak (Jateng)</span>
                <span class="text-[10px] text-slate-500">Workshop Jawa Tengah</span>
              </a>
              <a href="/lokasi-workshop/#workshop-pekanbaru" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="text-xs font-bold text-slate-900">Pekanbaru (Riau)</span>
                <span class="text-[10px] text-slate-500">Sektor Sawit &amp; Energi</span>
              </a>
              <a href="/lokasi-workshop/#workshop-timika" class="flex flex-col p-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="text-xs font-bold text-slate-900">Timika (Papua)</span>
                <span class="text-[10px] text-slate-500">Heavy Mining Support</span>
              </a>
            </div>
            <div class="mt-3 pt-2.5 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-400 text-[10px]">Layanan On-Site &amp; Pick-Up</span>
              <a href="/lokasi-workshop/" class="text-[11px] font-bold text-brand-700 hover:text-brand-800">Detail 8 Lokasi Workshop &rarr;</a>
            </div>
          </div>
        </div>

        <!-- 5. Proyek Dropdown -->
        <div class="relative group h-full flex items-center">
          <a
            href="/proyek/"
            class:list={[
              'inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider transition-colors py-2 relative select-none',
              currentPath.startsWith('/proyek')
                ? 'text-brand-700 after:absolute after:bottom-0 after:left-0 after:right-0 after:h-0.5 after:bg-brand-600'
                : 'text-slate-700 hover:text-slate-950'
            ]}
          >
            <span>Proyek</span>
