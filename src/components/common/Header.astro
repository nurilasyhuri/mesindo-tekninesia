<script is:inline define:vars={{ searchItems }}>
  (function() {
    // Search elements
    const searchTrigger = document.getElementById('search-trigger');
    const searchOverlay = document.getElementById('search-overlay');
    const searchBox = document.getElementById('search-box');
    const searchInput = document.getElementById('search-input');
    const closeSearchBtn = document.getElementById('close-search-btn');
    const defaultState = document.getElementById('search-default-state');
    const resultsWrapper = document.getElementById('search-results-wrapper');
    const resultsList = document.getElementById('search-results-list');
    const noResults = document.getElementById('search-no-results');
    const countLabel = document.getElementById('search-count-label');
    const tabPills = document.querySelectorAll('.search-tab-pill');

    let activeCategory = 'all';

    function openSearch() {
      if (!searchOverlay || !searchBox || !searchInput) return;
      searchOverlay.classList.remove('hidden');
      requestAnimationFrame(() => {
        searchOverlay.classList.remove('opacity-0');
        searchBox.classList.remove('-translate-y-2', 'opacity-0');
        searchInput.focus();
      });
      document.body.style.overflow = 'hidden';
    }

    function closeSearch() {
      if (!searchOverlay || !searchBox) return;
      searchOverlay.classList.add('opacity-0');
      searchBox.classList.add('-translate-y-2', 'opacity-0');
      setTimeout(() => {
        searchOverlay.classList.add('hidden');
        document.body.style.overflow = '';
      }, 150);
    }

    if (searchTrigger) searchTrigger.addEventListener('click', openSearch);
    if (closeSearchBtn) closeSearchBtn.addEventListener('click', closeSearch);

    if (searchOverlay) {
      searchOverlay.addEventListener('click', (e) => {
        if (e.target === searchOverlay) closeSearch();
      });
    }

    // Keyboard shortcut ⌘K / Ctrl+K
    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (searchOverlay && searchOverlay.classList.contains('hidden')) {
          openSearch();
        } else {
          closeSearch();
        }
      }
      if (e.key === 'Escape' && searchOverlay && !searchOverlay.classList.contains('hidden')) {
        closeSearch();
      }
    });

    // Category Tabs
    tabPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        tabPills.forEach((p) => {
          p.classList.remove('bg-slate-900', 'text-white');
          p.classList.add('text-slate-600');
        });
        pill.classList.add('bg-slate-900', 'text-white');
        pill.classList.remove('text-slate-600');
        activeCategory = pill.dataset.category || 'all';
        renderResults(searchInput ? searchInput.value : '');
      });
    });

    // Keyword tags
    document.querySelectorAll('.search-keyword-tag').forEach((btn) => {
      btn.addEventListener('click', () => {
        const query = btn.dataset.query || '';
        if (searchInput) {
          searchInput.value = query;
          renderResults(query);
          searchInput.focus();
        }
      });
    });

    function renderResults(rawQuery) {
      const q = rawQuery.trim().toLowerCase();
      if (!q) {
        if (defaultState) defaultState.classList.remove('hidden');
        if (resultsWrapper) resultsWrapper.classList.add('hidden');
        if (noResults) noResults.classList.add('hidden');
        return;
      }

      const filtered = searchItems.filter((item) => {
        const matchesCategory = activeCategory === 'all' || item.category === activeCategory;
        if (!matchesCategory) return false;
        return (
          item.title.toLowerCase().includes(q) ||
          item.desc.toLowerCase().includes(q)
        );
      });

      if (defaultState) defaultState.classList.add('hidden');

      if (filtered.length === 0) {
        if (resultsWrapper) resultsWrapper.classList.add('hidden');
        if (noResults) noResults.classList.remove('hidden');
        return;
      }

      if (noResults) noResults.classList.add('hidden');
      if (resultsWrapper) resultsWrapper.classList.remove('hidden');
      if (countLabel) countLabel.textContent = `${filtered.length} hasil ditemukan`;

      if (resultsList) {
        resultsList.innerHTML = filtered.slice(0, 8).map((item) => `
          <a href="${item.url}" class="flex items-center gap-3 p-2 rounded-lg hover:bg-slate-100 transition-colors">
            <div class="w-8 h-8 rounded bg-slate-100 border border-slate-200 overflow-hidden shrink-0 flex items-center justify-center">
              <img src="${item.img}" alt="" class="w-full h-full object-cover" onerror="this.style.display='none'" />
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold text-slate-900 truncate">${item.title}</span>
                <span class="text-[9px] font-semibold bg-slate-100 px-1.5 py-0.5 rounded text-slate-600">${item.category}</span>
              </div>
              <p class="text-[11px] text-slate-500 truncate">${item.desc}</p>
            </div>
            <span class="text-xs text-slate-400 font-bold">&rarr;</span>
          </a>
        `).join('');
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        renderResults(e.target.value);
      });
    }

    // Dual Mega Menu Panel Logic (Layanan & Katalog)
    const servicesTrigger = document.getElementById('mega-menu-trigger');
    const servicesPanel = document.getElementById('mega-menu-panel');
    const servicesChevron = document.getElementById('mega-chevron');
    const servicesWrapper = document.getElementById('mega-menu-wrapper');

    const catalogTrigger = document.getElementById('catalog-mega-trigger');
    const catalogPanel = document.getElementById('catalog-mega-panel');
    const catalogChevron = document.getElementById('catalog-mega-chevron');
    const catalogWrapper = document.getElementById('catalog-mega-wrapper');

    const megaBackdrop = document.getElementById('mega-menu-backdrop');
    let megaTimeout = null;

    function openServices() {
      clearTimeout(megaTimeout);
      closeCatalog(false);
      if (!servicesPanel || !servicesTrigger) return;
      servicesPanel.classList.remove('hidden');
      if (megaBackdrop) megaBackdrop.classList.remove('hidden');
      servicesTrigger.setAttribute('aria-expanded', 'true');
      servicesTrigger.classList.add('bg-slate-200/90', 'text-slate-950', 'shadow-2xs');
      servicesTrigger.classList.remove('bg-slate-100', 'text-slate-800');
      if (servicesChevron) {
        servicesChevron.classList.add('rotate-180', 'text-slate-950');
        servicesChevron.classList.remove('text-slate-500');
      }
    }

    function closeServices(hideBackdrop = true) {
      if (!servicesPanel || !servicesTrigger) return;
      servicesPanel.classList.add('hidden');
      servicesTrigger.setAttribute('aria-expanded', 'false');
      servicesTrigger.classList.remove('bg-slate-200/90', 'text-slate-950', 'shadow-2xs');
      servicesTrigger.classList.add('bg-slate-100', 'text-slate-800');
      if (servicesChevron) {
        servicesChevron.classList.remove('rotate-180', 'text-slate-950');
        servicesChevron.classList.add('text-slate-500');
      }
      if (hideBackdrop && (!catalogPanel || catalogPanel.classList.contains('hidden'))) {
        if (megaBackdrop) megaBackdrop.classList.add('hidden');
      }
    }

    function toggleServices() {
      if (!servicesPanel) return;
      if (servicesPanel.classList.contains('hidden')) {
        openServices();
      } else {
        closeServices(true);
      }
    }

    function openCatalog() {
      clearTimeout(megaTimeout);
      closeServices(false);
      if (!catalogPanel || !catalogTrigger) return;
      catalogPanel.classList.remove('hidden');
      if (megaBackdrop) megaBackdrop.classList.remove('hidden');
      catalogTrigger.setAttribute('aria-expanded', 'true');
      catalogTrigger.classList.add('bg-slate-200/90', 'text-slate-950', 'shadow-2xs');
      catalogTrigger.classList.remove('bg-slate-100', 'text-slate-800');
      if (catalogChevron) {
        catalogChevron.classList.add('rotate-180', 'text-slate-950');
        catalogChevron.classList.remove('text-slate-500');
      }
    }

    function closeCatalog(hideBackdrop = true) {
      if (!catalogPanel || !catalogTrigger) return;
      catalogPanel.classList.add('hidden');
      catalogTrigger.setAttribute('aria-expanded', 'false');
      catalogTrigger.classList.remove('bg-slate-200/90', 'text-slate-950', 'shadow-2xs');
      catalogTrigger.classList.add('bg-slate-100', 'text-slate-800');
      if (catalogChevron) {
        catalogChevron.classList.remove('rotate-180', 'text-slate-950');
        catalogChevron.classList.add('text-slate-500');
      }
      if (hideBackdrop && (!servicesPanel || servicesPanel.classList.contains('hidden'))) {
        if (megaBackdrop) megaBackdrop.classList.add('hidden');
      }
    }

    function toggleCatalog() {
      if (!catalogPanel) return;
      if (catalogPanel.classList.contains('hidden')) {
        openCatalog();
      } else {
        closeCatalog(true);
      }
    }

    function closeAllMega() {
      clearTimeout(megaTimeout);
      closeServices(false);
      closeCatalog(false);
      if (megaBackdrop) megaBackdrop.classList.add('hidden');
    }

    // Services event listeners
    if (servicesTrigger) {
      servicesTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleServices();
      });
    }

    if (servicesWrapper) {
      servicesWrapper.addEventListener('mouseenter', () => {
        clearTimeout(megaTimeout);
        openServices();
      });
      servicesWrapper.addEventListener('mouseleave', () => {
        megaTimeout = setTimeout(() => {
          closeServices(true);
        }, 180);
      });
    }

    if (servicesPanel) {
      servicesPanel.addEventListener('mouseenter', () => {
        clearTimeout(megaTimeout);
      });
      servicesPanel.addEventListener('mouseleave', () => {
        megaTimeout = setTimeout(() => {
          closeServices(true);
        }, 180);
      });
      servicesPanel.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', closeAllMega);
      });
    }

    // Catalog event listeners
    if (catalogTrigger) {
      catalogTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleCatalog();
      });
    }

    if (catalogWrapper) {
      catalogWrapper.addEventListener('mouseenter', () => {
        clearTimeout(megaTimeout);
        openCatalog();
      });
      catalogWrapper.addEventListener('mouseleave', () => {
        megaTimeout = setTimeout(() => {
          closeCatalog(true);
        }, 180);
      });
    }

    if (catalogPanel) {
      catalogPanel.addEventListener('mouseenter', () => {
        clearTimeout(megaTimeout);
      });
      catalogPanel.addEventListener('mouseleave', () => {
        megaTimeout = setTimeout(() => {
          closeCatalog(true);
        }, 180);
      });
      catalogPanel.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', closeAllMega);
      });
    }

    if (megaBackdrop) {
      megaBackdrop.addEventListener('click', closeAllMega);
    }

    // Close on outside click
    document.addEventListener('click', (e) => {
      const isInsideServices = servicesPanel && servicesPanel.contains(e.target);
      const isInsideServicesBtn = servicesTrigger && servicesTrigger.contains(e.target);
      const isInsideCatalog = catalogPanel && catalogPanel.contains(e.target);
      const isInsideCatalogBtn = catalogTrigger && catalogTrigger.contains(e.target);

      if (!isInsideServices && !isInsideServicesBtn && !isInsideCatalog && !isInsideCatalogBtn) {
        closeAllMega();
      }
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAllMega();
      }
    });

    // Mobile Drawer
    const menuBtn = document.getElementById('menu-btn');
    const closeMenuBtn = document.getElementById('close-menu-btn');
    const mobileDrawer = document.getElementById('mobile-drawer');
    const drawerBackdrop = document.getElementById('mobile-drawer-backdrop');

    function openMobileDrawer() {
      if (!mobileDrawer || !drawerBackdrop) return;
      drawerBackdrop.classList.remove('hidden');
      requestAnimationFrame(() => {
        drawerBackdrop.classList.remove('opacity-0');
        mobileDrawer.classList.remove('-translate-x-full');
      });
      document.body.style.overflow = 'hidden';
    }

    function closeMobileDrawer() {
      if (!mobileDrawer || !drawerBackdrop) return;
      drawerBackdrop.classList.add('opacity-0');
      mobileDrawer.classList.add('-translate-x-full');
      setTimeout(() => {
        drawerBackdrop.classList.add('hidden');
        document.body.style.overflow = '';
      }, 200);
    }

    if (menuBtn) menuBtn.addEventListener('click', openMobileDrawer);
    if (closeMenuBtn) closeMenuBtn.addEventListener('click', closeMobileDrawer);
    if (drawerBackdrop) drawerBackdrop.addEventListener('click', closeMobileDrawer);

    const drawerSearchBtn = document.getElementById('drawer-search-btn');
    if (drawerSearchBtn) {
      drawerSearchBtn.addEventListener('click', () => {
        closeMobileDrawer();
        setTimeout(openSearch, 220);
      });
    }

    if (mobileDrawer) {
      mobileDrawer.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', closeMobileDrawer);
      });
    }

    // Sync RFQ Cart Count badge from localStorage
    function updateHeaderRfqCount() {
      try {
        const stored = localStorage.getItem('mesindo_rfq_cart');
        const cart = stored ? JSON.parse(stored) : [];
        const count = cart.reduce((sum, item) => sum + (item.qty || 1), 0);
        document.querySelectorAll('.rfq-cart-count').forEach((el) => {
          if (count > 0) {
            el.textContent = count;
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        });
      } catch (e) {}
    }

    window.addEventListener('storage', updateHeaderRfqCount);
    window.addEventListener('rfq-cart-updated', updateHeaderRfqCount);
    updateHeaderRfqCount();
  })();
</script>
