      <!-- 2. Layanan -->
      <div class="border-t border-slate-100 pt-3">
        <div class="flex items-center justify-between px-3 mb-1.5">
          <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Layanan Workshop &amp; On-Site</span>
          <a href="/layanan/" class="text-[11px] font-bold text-brand-700 hover:text-brand-800">Semua Layanan (8) &rarr;</a>
        </div>
        <div class="space-y-0.5">
          <a href="/layanan/electro-motor/" class="flex items-center justify-between py-1.5 px-3 rounded-lg text-slate-800 hover:bg-slate-50">
            <span>Electro Motor (Repair, Rewind, Overhaul)</span>
            <span class="text-slate-400">&rarr;</span>
          </a>
          <a href="/layanan/generator/" class="flex items-center justify-between py-1.5 px-3 rounded-lg text-slate-800 hover:bg-slate-50">
            <span>Generator Stator &amp; Rotor Services</span>
            <span class="text-slate-400">&rarr;</span>
          </a>
          <a href="/layanan/high-speed-balancing/" class="flex items-center justify-between py-1.5 px-3 rounded-lg text-slate-800 hover:bg-slate-50">
            <span class="font-semibold text-brand-700">High Speed Balancing 150 Ton</span>
            <span class="text-slate-400">&rarr;</span>
          </a>
          <a href="/layanan/industrial-machining/" class="flex items-center justify-between py-1.5 px-3 rounded-lg text-slate-800 hover:bg-slate-50">
            <span>Vertical Lathe 6.7m &amp; Horizontal 15m</span>
            <span class="text-slate-400">&rarr;</span>
          </a>
          <a href="/layanan/transformer/" class="flex items-center justify-between py-1.5 px-3 rounded-lg text-slate-800 hover:bg-slate-50">
            <span>Transformer &amp; Oil Purification</span>
            <span class="text-slate-400">&rarr;</span>
          </a>
          <a href="/layanan/testing-assessment/" class="flex items-center justify-between py-1.5 px-3 rounded-lg text-slate-800 hover:bg-slate-50">
            <span>Testing, EL CID &amp; Partial Discharge</span>
            <span class="text-slate-400">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- 3. Fasilitas -->
      <div class="border-t border-slate-100 pt-3">
        <div class="flex items-center justify-between px-3 mb-1.5">
          <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Fasilitas Permesinan</span>
          <a href="/fasilitas/" class="text-[11px] font-bold text-brand-700 hover:text-brand-800">Katalog Fasilitas &rarr;</a>
        </div>
        <div class="space-y-0.5">
          <a href="/layanan/high-speed-balancing/" class="flex items-center justify-between py-1.5 px-3 rounded-lg text-slate-800 hover:bg-slate-50">
            <span>Balancing Tunnel s/d 150 Ton</span>
            <span class="text-slate-400">&rarr;</span>
          </a>
          <a href="/layanan/industrial-machining/" class="flex items-center justify-between py-1.5 px-3 rounded-lg text-slate-800 hover:bg-slate-50">
            <span>Vertical Lathe 6.7m x 8m</span>
            <span class="text-slate-400">&rarr;</span>
          </a>
          <a href="/fasilitas/" class="flex items-center justify-between py-1.5 px-3 rounded-lg text-slate-800 hover:bg-slate-50">
            <span>VPI Vacuum Impregnation Tank Class H</span>
            <span class="text-slate-400">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- 4. Workshop -->
      <div class="border-t border-slate-100 pt-3">
        <div class="flex items-center justify-between px-3 mb-1.5">
          <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Jaringan Workshop Nasional</span>
          <a href="/lokasi-workshop/" class="text-[11px] font-bold text-brand-700 hover:text-brand-800">8 Lokasi &rarr;</a>
        </div>
        <div class="space-y-0.5">
          <a href="/lokasi-workshop/#workshop-jakarta-utara" class="flex items-center justify-between py-1.5 px-3 rounded-lg text-slate-800 hover:bg-slate-50">
            <span>Jakarta Utara HQ (25.000 M²)</span>
            <span class="text-slate-400">&rarr;</span>
          </a>
          <a href="/lokasi-workshop/#workshop-makassar" class="flex items-center justify-between py-1.5 px-3 rounded-lg text-slate-800 hover:bg-slate-50">
            <span>Makassar Sulawesi (5.000 M²)</span>
            <span class="text-slate-400">&rarr;</span>
          </a>
          <a href="/lokasi-workshop/#workshop-purwakarta" class="flex items-center justify-between py-1.5 px-3 rounded-lg text-slate-800 hover:bg-slate-50">
            <span>Purwakarta &amp; Sidoarjo</span>
            <span class="text-slate-400">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- 5. Proyek & Perusahaan -->
      <div class="border-t border-slate-100 pt-3">
        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 px-3 block mb-1.5">Perusahaan &amp; Kontak</span>
        <div class="space-y-0.5">
          <a href="/proyek/" class="flex items-center justify-between py-1.5 px-3 rounded-lg text-slate-800 hover:bg-slate-50">
            <span>Portofolio Proyek &amp; Studi Kasus</span>
            <span class="text-slate-400">&rarr;</span>
          </a>
          <a href="/tentang-kami/" class="flex items-center justify-between py-1.5 px-3 rounded-lg text-slate-800 hover:bg-slate-50">
            <span>Tentang Kami (Profil &amp; Sertifikasi ISO)</span>
            <span class="text-slate-400">&rarr;</span>
          </a>
          <a href="/kontak/" class="flex items-center justify-between py-1.5 px-3 rounded-lg text-slate-800 hover:bg-slate-50">
            <span>Kontak &amp; Alamat Kantor Pusat</span>
            <span class="text-slate-400">&rarr;</span>
          </a>
          <a href={waInquiryUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between py-1.5 px-3 rounded-lg text-brand-700 font-bold hover:bg-brand-50">
            <span>Hotline WhatsApp (0851-8300-2070)</span>
            <span class="text-emerald-500">●</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Drawer RFQ CTA -->
    <div class="pt-4 border-t border-slate-200 space-y-2">
      <a
        href={rfqUrl}
        class="w-full flex items-center justify-center gap-2 py-3 rounded-full bg-slate-900 text-white font-semibold text-xs tracking-wide uppercase shadow-xs transition-colors"
      >
        <span>Request Quotation (RFQ)</span>
      </a>
      <a
        href={waInquiryUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-2 py-3 rounded-full bg-brand-600 text-white font-semibold text-xs tracking-wide shadow-xs transition-colors"
      >
        <span>Konsultasi Engineering WhatsApp</span>
      </a>
    </div>
  </div>
</aside>

<script>
  function initHeader() {
    // Mobile Drawer
    const menuBtn = document.getElementById('menu-btn');
    const mobileDrawer = document.getElementById('mobile-drawer');
    const drawerBackdrop = document.getElementById('mobile-drawer-backdrop');
    const closeMenuBtn = document.getElementById('close-menu-btn');

    function openMenu() {
      if (!mobileDrawer || !drawerBackdrop) return;
      drawerBackdrop.classList.remove('hidden');
      setTimeout(() => {
        drawerBackdrop.classList.remove('opacity-0');
        drawerBackdrop.classList.add('opacity-100');
        mobileDrawer.classList.remove('translate-y-full');
        mobileDrawer.classList.add('translate-y-0');
      }, 10);
      document.body.classList.add('overflow-hidden');
    }

    function closeMenu() {
      if (!mobileDrawer || !drawerBackdrop) return;
      mobileDrawer.classList.remove('translate-y-0');
      mobileDrawer.classList.add('translate-y-full');
      drawerBackdrop.classList.remove('opacity-100');
      drawerBackdrop.classList.add('opacity-0');
      setTimeout(() => {
        drawerBackdrop.classList.add('hidden');
      }, 250);
      document.body.classList.remove('overflow-hidden');
    }

    menuBtn?.addEventListener('click', openMenu);
    closeMenuBtn?.addEventListener('click', closeMenu);
    drawerBackdrop?.addEventListener('click', closeMenu);

    // Search Elements
    const searchTrigger = document.getElementById('search-trigger');
    const drawerSearchTrigger = document.getElementById('drawer-search-trigger');
    const searchOverlay = document.getElementById('search-overlay');
    const searchBox = document.getElementById('search-box');
    const closeSearchBtn = document.getElementById('close-search-btn');
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const searchClearBtn = document.getElementById('search-clear-btn');
    const searchDefaultState = document.getElementById('search-default-state');
    const searchResultsWrapper = document.getElementById('search-results-wrapper');
    const searchResultsList = document.getElementById('search-results-list');
    const searchNoResults = document.getElementById('search-no-results');
    const searchNoResultsQuery = document.getElementById('search-no-results-query');
    const searchCountLabel = document.getElementById('search-count-label');
    const tabPills = document.querySelectorAll<HTMLButtonElement>('.search-tab-pill');
    const keywordTags = document.querySelectorAll<HTMLButtonElement>('.search-keyword-tag');

    interface SearchItem {
      title: string;
      desc: string;
      url: string;
      category: string;
      badge: string;
      img: string;
    }

    let searchItems: SearchItem[] = [];
    try {
      const raw = document.getElementById('search-index-json')?.textContent;
      if (raw) searchItems = JSON.parse(raw);
    } catch {
      searchItems = [];
    }

    let activeCategory = 'all';
    let currentResults: SearchItem[] = [];
    let activeIndex = -1;

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function highlight(text: string, q: string): string {
      if (!q.trim()) return escapeHtml(text);
      const terms = q.trim().split(/\s+/).filter(Boolean);
      if (terms.length === 0) return escapeHtml(text);
      try {
        const regex = new RegExp(`(${terms.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`, 'gi');
        return escapeHtml(text).replace(regex, '<mark class="bg-brand-100 text-brand-950 px-0.5 rounded font-bold">$1</mark>');
      } catch {
        return escapeHtml(text);
      }
    }

    function getBadgeStyle(cat: string): string {
      switch (cat) {
        case 'Layanan':
          return 'bg-brand-50 text-brand-800 border border-brand-200';
        case 'Fasilitas':
          return 'bg-amber-50 text-amber-900 border border-amber-200';
        case 'Proyek':
          return 'bg-emerald-50 text-emerald-800 border border-emerald-200';
        case 'Workshop':
          return 'bg-slate-100 text-slate-800 border border-slate-200';
        default:
          return 'bg-slate-100 text-slate-700 border border-slate-200';
      }
    }

    function updateVisualSelection() {
      const domItems = searchResultsList?.querySelectorAll<HTMLElement>('.search-result-item');
      if (!domItems) return;
      domItems.forEach((el, i) => {
        if (i === activeIndex) {
          el.classList.add('bg-brand-50/80', 'border-brand-300', 'ring-1', 'ring-brand-300');
          el.classList.remove('bg-white', 'border-slate-100');
          el.setAttribute('aria-selected', 'true');
          el.scrollIntoView({ block: 'nearest' });
        } else {
          el.classList.remove('bg-brand-50/80', 'border-brand-300', 'ring-1', 'ring-brand-300');
          el.classList.add('bg-white', 'border-slate-100');
          el.setAttribute('aria-selected', 'false');
        }
      });
    }

    function performSearch(query: string) {
      const q = query.trim().toLowerCase();
      const terms = q ? q.split(/\s+/).filter(Boolean) : [];

      let filtered = searchItems;
      if (activeCategory !== 'all') {
        filtered = filtered.filter((it) => it.category === activeCategory);
      }

      if (terms.length > 0) {
        filtered = filtered.filter((it) => {
          const haystack = `${it.title} ${it.desc} ${it.badge} ${it.category}`.toLowerCase();
          return terms.every((t) => haystack.includes(t));
        });
      }

      currentResults = filtered;
      activeIndex = currentResults.length > 0 ? 0 : -1;

      if (!q && activeCategory === 'all') {
        searchClearBtn?.classList.add('hidden');
        searchDefaultState?.classList.remove('hidden');
        searchResultsWrapper?.classList.add('hidden');
        searchNoResults?.classList.add('hidden');
        return;
      }

      searchDefaultState?.classList.add('hidden');
      if (q) {
        searchClearBtn?.classList.remove('hidden');
      } else {
        searchClearBtn?.classList.add('hidden');
      }

      if (currentResults.length === 0) {
        searchResultsWrapper?.classList.add('hidden');
        searchNoResults?.classList.remove('hidden');
        if (searchNoResultsQuery) {
          searchNoResultsQuery.textContent = q
            ? `Tidak ditemukan hasil untuk "${query}". Coba cari "electro motor", "balancing", "lathe", atau "sidoarjo".`
            : 'Tidak ada item dalam filter kategori ini.';
        }
      } else {
        searchNoResults?.classList.add('hidden');
        searchResultsWrapper?.classList.remove('hidden');
        if (searchCountLabel) {
          searchCountLabel.textContent = `Ditemukan ${currentResults.length} hasil${q ? ` untuk "${query}"` : ''}`;
        }

        if (searchResultsList) {
          searchResultsList.innerHTML = currentResults
            .map((item, index) => {
              const isSelected = index === activeIndex;
              const badgeStyle = getBadgeStyle(item.category);
              return `
                <a
                  href="${item.url}"
                  role="option"
                  aria-selected="${isSelected}"
                  data-index="${index}"
                  class="search-result-item flex items-center gap-3 p-2.5 sm:p-3 rounded-xl border transition-all duration-150 cursor-pointer ${
                    isSelected
                      ? 'bg-brand-50/80 border-brand-300 ring-1 ring-brand-300'
                      : 'bg-white border-slate-100 hover:border-slate-200 hover:bg-slate-50'
                  }"
                >
                  <img
                    src="${item.img}"
                    alt="${escapeHtml(item.title)}"
                    class="w-11 h-11 sm:w-12 sm:h-12 rounded-lg object-cover bg-slate-100 border border-slate-200 shrink-0"
                    loading="lazy"
                    onerror="this.style.opacity='0.3'"
                  />
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2 mb-0.5">
                      <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full ${badgeStyle}">
                        ${escapeHtml(item.badge)}
                      </span>
                    </div>
                    <h4 class="text-xs sm:text-sm font-bold text-slate-900 truncate">
                      ${highlight(item.title, query)}
                    </h4>
                    <p class="text-[11px] text-slate-500 line-clamp-1 mt-0.5">
                      ${escapeHtml(item.desc)}
                    </p>
                  </div>
                  <div class="shrink-0 text-slate-300 pr-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path d="M9 18l6-6-6-6"></path>
                    </svg>
                  </div>
                </a>
              `;
            })
            .join('');

          searchResultsList.querySelectorAll('.search-result-item').forEach((el) => {
            el.addEventListener('mouseenter', () => {
              const idx = Number(el.getAttribute('data-index'));
              if (!isNaN(idx)) {
                activeIndex = idx;
                updateVisualSelection();
              }
            });
          });
        }
      }
    }

    // Tabs
    tabPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        tabPills.forEach((p) => {
          p.classList.remove('bg-brand-100', 'text-brand-800', 'font-semibold');
          p.classList.add('text-slate-600', 'font-medium');
        });
        pill.classList.remove('text-slate-600', 'font-medium');
        pill.classList.add('bg-brand-100', 'text-brand-800', 'font-semibold');
        activeCategory = pill.getAttribute('data-category') || 'all';
        performSearch(searchInput?.value || '');
      });
    });

    // Keywords
    keywordTags.forEach((tag) => {
      tag.addEventListener('click', () => {
        const q = tag.getAttribute('data-query') || '';
        if (searchInput) {
          searchInput.value = q;
          searchInput.focus();
          performSearch(q);
        }
      });
    });

    searchClearBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
        performSearch('');
      }
    });

    searchInput?.addEventListener('input', () => {
      performSearch(searchInput.value);
    });

    searchInput?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (currentResults.length > 0) {
          activeIndex = (activeIndex + 1) % currentResults.length;
          updateVisualSelection();
        }
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (currentResults.length > 0) {
          activeIndex = (activeIndex - 1 + currentResults.length) % currentResults.length;
          updateVisualSelection();
        }
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (activeIndex >= 0 && activeIndex < currentResults.length) {
          window.location.href = currentResults[activeIndex].url;
        } else if (currentResults.length > 0) {
          window.location.href = currentResults[0].url;
        }
      }
    });

    function openSearch() {
      if (!searchOverlay || !searchBox) return;
      closeMenu();
      searchOverlay.classList.remove('hidden');
      setTimeout(() => {
        searchOverlay.classList.remove('opacity-0');
        searchOverlay.classList.add('opacity-100');
        searchBox.classList.remove('-translate-y-4', 'opacity-0');
        searchBox.classList.add('translate-y-0', 'opacity-100');
        searchInput?.focus();
        performSearch(searchInput?.value || '');
      }, 10);
      document.body.classList.add('overflow-hidden');
    }

    function closeSearch() {
      if (!searchOverlay || !searchBox) return;
      searchBox.classList.remove('translate-y-0', 'opacity-100');
      searchBox.classList.add('-translate-y-4', 'opacity-0');
      searchOverlay.classList.remove('opacity-100');
      searchOverlay.classList.add('opacity-0');
      setTimeout(() => {
        searchOverlay.classList.add('hidden');
      }, 200);
      document.body.classList.remove('overflow-hidden');
    }

    searchTrigger?.addEventListener('click', openSearch);
    drawerSearchTrigger?.addEventListener('click', openSearch);
    closeSearchBtn?.addEventListener('click', closeSearch);

    searchOverlay?.addEventListener('click', (e) => {
      if (e.target === searchOverlay) {
        closeSearch();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeSearch();
        closeMenu();
      } else if (
        (e.key === '/' || (e.key === 'k' && (e.metaKey || e.ctrlKey))) &&
        !['INPUT', 'TEXTAREA', 'SELECT'].includes((e.target as HTMLElement)?.tagName)
      ) {
        e.preventDefault();
        openSearch();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initHeader);
</script>
