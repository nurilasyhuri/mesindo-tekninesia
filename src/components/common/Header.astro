  class="fixed inset-0 bg-slate-950/70 backdrop-blur-xs z-50 hidden opacity-0 transition-opacity duration-150 flex items-start justify-center p-3 sm:p-6 sm:pt-16 font-sans"
  role="dialog"
  aria-modal="true"
  aria-label="Pencarian Cepat Mesindo Teknisia"
>
  <div
    id="search-box"
    class="w-full max-w-2xl bg-white border border-slate-200 rounded-2xl shadow-2xl flex flex-col transition-all duration-150 transform -translate-y-2 opacity-0 max-h-[85vh] overflow-hidden"
  >
    <!-- Search Input -->
    <div class="relative flex items-center px-4 py-3 border-b border-slate-200 bg-white">
      <svg class="w-5 h-5 text-slate-400 shrink-0 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.34-4.34"></path>
      </svg>
      <input
        id="search-input"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="Ketik equipment, sparepart (bearing, kawat, seal), layanan, atau lokasi workshop..."
        class="w-full bg-transparent border-none text-slate-900 focus:outline-none text-base sm:text-sm placeholder:text-slate-400 font-sans pr-16"
      />
      <button
        id="close-search-btn"
        type="button"
        aria-label="Tutup dialog pencarian"
        class="p-1 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-md transition-colors cursor-pointer inline-flex items-center gap-1"
      >
        <span class="text-[10px] font-mono text-slate-400 bg-slate-100 px-1 py-0.5 rounded border border-slate-200">ESC</span>
      </button>
    </div>

    <!-- Category Filter Pills -->
    <div class="flex items-center gap-1.5 px-4 py-2 bg-slate-50 border-b border-slate-100 overflow-x-auto text-xs no-scrollbar">
      <button type="button" class="search-tab-pill px-3 py-1 rounded-full text-xs font-semibold bg-slate-900 text-white cursor-pointer" data-category="all">
        Semua
      </button>
      <button type="button" class="search-tab-pill px-3 py-1 rounded-full text-xs font-medium text-slate-600 hover:bg-slate-200/60 cursor-pointer" data-category="Sparepart">
        Sparepart ({SPAREPARTS_CATALOG.length})
      </button>
      <button type="button" class="search-tab-pill px-3 py-1 rounded-full text-xs font-medium text-slate-600 hover:bg-slate-200/60 cursor-pointer" data-category="Layanan">
        Layanan
      </button>
      <button type="button" class="search-tab-pill px-3 py-1 rounded-full text-xs font-medium text-slate-600 hover:bg-slate-200/60 cursor-pointer" data-category="Workshop">
        {COMPANY_INFO.workshops.length} Workshop
      </button>
      <button type="button" class="search-tab-pill px-3 py-1 rounded-full text-xs font-medium text-slate-600 hover:bg-slate-200/60 cursor-pointer" data-category="Fasilitas">
        Fasilitas
      </button>
    </div>

    <!-- Search Scrollable Container -->
    <div id="search-scroll-container" class="overflow-y-auto max-h-[60vh] p-4">
      <!-- Default Zero State -->
      <div id="search-default-state" class="space-y-4 py-1">
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-2">
            Pencarian Populer
          </span>
          <div class="flex flex-wrap gap-1.5">
            {['Bearing Motor Listrik', 'Kawat Tembaga Enamel', 'Varnish VPI', 'Oil Seal Motor', 'Balancing 150 Ton', 'Vertical Lathe', 'Workshop Sidoarjo'].map((tag) => (
              <button
                type="button"
                class="search-keyword-tag inline-flex items-center bg-slate-100 hover:bg-slate-200 text-slate-700 hover:text-slate-900 px-3 py-1 rounded-full text-xs font-medium transition-colors cursor-pointer"
                data-query={tag}
              >
                {tag}
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- Results Container -->
      <div id="search-results-wrapper" class="hidden space-y-1 py-1">
        <div class="flex items-center justify-between pb-2">
          <span id="search-count-label" class="text-xs font-semibold text-slate-500">Hasil pencarian</span>
          <span class="text-[10px] text-slate-400">Gunakan panah ↑ ↓ lalu Enter</span>
        </div>
        <div id="search-results-list" class="space-y-1"></div>
      </div>

      <!-- No Results -->
      <div id="search-no-results" class="hidden py-8 text-center space-y-2">
        <h4 class="text-sm font-bold text-slate-900">Tidak ada hasil yang cocok</h4>
        <p class="text-xs text-slate-500 max-w-sm mx-auto">
          Silakan coba kata kunci lain atau hubungi tim engineering kami via WhatsApp.
        </p>
      </div>
    </div>
  </div>
</div>

