        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.34-4.34"></path>
        </svg>
        <span>Cari equipment, layanan, fasilitas...</span>
      </div>
      <span class="text-[10px] font-bold text-brand-700 uppercase">Cari &rarr;</span>
    </button>

    <div class="space-y-4 text-xs font-sans">
      
      <!-- 1. Beranda -->
      <div class="space-y-1">
        <a href="/" class="flex items-center justify-between py-2 px-3 rounded-lg font-bold text-slate-900 hover:bg-slate-50 text-sm">
